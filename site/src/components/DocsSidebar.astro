---
import { getCollection } from 'astro:content';

const docsEntries = await getCollection('docs');

// Sort them so Installation is first, then Usage, etc.
const order = ['installation', 'usage', 'configuration', 'internals'];
docsEntries.sort((a, b) => {
	const aIndex = order.indexOf(a.slug);
	const bIndex = order.indexOf(b.slug);
	if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
	if (aIndex !== -1) return -1;
	if (bIndex !== -1) return 1;
	return a.data.title.localeCompare(b.data.title);
});

const { currentSlug } = Astro.props;
---

<aside class="w-64 flex-shrink-0 border-r border-muted/10 hidden md:block">
	<nav class="sticky top-24 p-8 space-y-8">
		<div>
			<h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-4">Getting Started</h3>
			<ul class="space-y-3">
				{docsEntries.map(entry => (
					<li>
						<a 
							href={`/gaur/docs/${entry.slug === 'index' ? '' : entry.slug}`} 
							class:list={[
								"text-sm font-medium transition-colors hover:text-primary",
								(currentSlug === entry.slug || (currentSlug === undefined && entry.slug === 'index')) ? "text-primary" : "text-text/70"
							]}
						>
							{entry.data.title}
						</a>
					</li>
				))}
			</ul>
		</div>
		
		<div class="pt-8 border-t border-muted/10">
			<h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-4">Resources</h3>
			<ul class="space-y-3">
				<li>
					<a href="https://github.com/prbhtkumr/gaur/issues" class="text-sm text-text/70 hover:text-primary transition-colors">Report Bug</a>
				</li>
				<li>
					<a href="https://github.com/prbhtkumr/gaur" class="text-sm text-text/70 hover:text-primary transition-colors">GitHub Repository</a>
				</li>
			</ul>
		</div>
	</nav>
</aside>
