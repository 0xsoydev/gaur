---
---
<div class="w-full max-w-4xl mx-auto px-4 mt-12 mb-20 font-mono text-[11px] md:text-xs">
  <div id="terminal-container" class="relative group">
    <!-- Elevated Border Shadow Effect (SHARP) -->
    <div class="absolute -inset-0.5 bg-sapphire/10 rounded-none blur opacity-10 group-hover:opacity-30 transition duration-1000 group-hover:duration-200"></div>
    
    <!-- Main Terminal Window (SHARP BORDERS) -->
    <div class="relative bg-base border border-surface1/60 rounded-none overflow-hidden shadow-2xl transition-all duration-300 hover:border-sapphire/30 min-h-[500px] flex flex-col">
      
      <!-- TUI Content Area -->
      <div class="grow flex flex-col gap-0 overflow-hidden relative text-text">
        
        <!-- Top Section: Details Pane (ROUNDED) -->
        <div class="mx-3 mt-3 h-[42%] border border-blue/30 rounded-gaur p-4 relative bg-surface0/20">
          <!-- Selection Pane (ABSOLUTE OVERLAY - Same border color as details) -->
          <div id="selection-pane" class="absolute -top-[1px] -right-[1px] w-48 border border-pink/40 rounded-gaur p-3 bg-base z-20 opacity-0 transition-opacity duration-500">
            <div class="text-pink font-bold mb-2 uppercase tracking-wider">Selected (<span id="select-count">0</span>) [*]</div>
            <div id="selected-items" class="space-y-1 text-subtext0 leading-tight">
              <!-- Populated by JS -->
            </div>
          </div>

          <div id="details-pane" class="opacity-0 transition-opacity duration-300 text-left">
            <div class="grid grid-cols-[100px_1fr] gap-x-2 gap-y-0.5">
              <span class="text-subtext0">Repository</span> <span id="detail-repo" class="text-blue"></span>
              <span class="text-subtext0">Name</span> <span id="detail-name" class="font-bold"></span>
              <span class="text-subtext0">Version</span> <span id="detail-version" class="text-subtext1"></span>
              <span class="text-subtext0">Description</span> <span id="detail-desc" class="text-text/90"></span>
              <span class="text-subtext0">Architecture</span> <span class="text-subtext1/70">x86_64</span>
              <span class="text-subtext0">URL</span> <span class="text-sapphire underline decoration-sapphire/30 truncate">https://www.mozilla.org/firefox/</span>
            </div>
          </div>
        </div>

        <!-- Bottom Section: Package List (MATCHING BORDER COLOR) -->
        <div class="mx-3 mb-1 flex-grow border border-blue/30 rounded-gaur flex flex-col justify-end relative bg-surface0/10 mt-3 overflow-hidden">
          <!-- Scrolling List -->
          <div id="package-list" class="flex flex-col-reverse gap-0.5 mb-2 overflow-hidden w-full">
            <!-- Populated by JS -->
          </div>
          
          <!-- Input Area -->
          <div class="border-t border-surface1/40 bg-surface0/5">
              <!-- Input Line -->
              <div class="flex items-center justify-between pt-2 pl-3 pr-3">
                <div class="flex items-center gap-2">
                    <span class="text-green font-bold">&gt;</span>
                    <span id="typing-input" class="text-text font-bold min-w-[1px]"></span>
                    <span id="cursor" class="w-1.5 h-4 bg-text/50 animate-pulse"></span>
                </div>
                <!-- Filter Hinting -->
                <div id="filter-hints" class="text-[10px] text-surface2 flex gap-2">
                    <span data-filter="c:">c:</span>
                    <span data-filter="e:">e:</span>
                    <span data-filter="m:">m:</span>
                    <span data-filter="a:">a:</span>
                </div>
              </div>
              
              <!-- Search Status -->
              <div id="search-status" class="text-[10px] text-subtext0 pb-2 pl-3 opacity-0 transition-opacity italic">
                Found <span id="pkg-count">0</span> packages (<span id="aur-count">0</span> from AUR)
              </div>
          </div>
        </div>
      </div>

      <!-- Shortcuts Bar -->
      <div class="flex justify-between items-center px-4 py-2 text-[9px] md:text-[10px] text-overlay2 tracking-tight border-t border-surface1/20 bg-mantle/30">
        <div id="repo-summary" class="flex gap-2">
            <!-- Populated by JS -->
        </div>
        <div class="flex gap-4">
            <span>[/]:search</span>
            <span>[tab]:mark</span>
            <span>[d]ash</span>
            <span class="text-blue font-bold">[i]nstall</span>
            <span>[u]pdate</span>
            <span>[r]emove</span>
            <span>[,]:settings</span>
            <span>[q]uit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Install Command Bar (ROUNDED) -->
  <div class="mt-4 max-w-2xl mx-auto">
    <div class="flex gap-4 px-4 mb-2">
        <button class="tab-btn active text-[10px] font-bold text-mauve tracking-widest uppercase transition-all hover:text-mauve" data-cmd="yay -S gaur-bin">
            [ yay ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="paru -S gaur-bin">
            [ paru ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="go install github.com/prbhtkumr/gaur@latest">
            [ go ]
        </button>
    </div>
    <div class="bg-crust border border-surface0 rounded-gaur p-4 flex items-center justify-between group shadow-xl">
        <div class="flex items-center gap-3">
            <span class="text-green font-bold">$</span>
            <code id="install-cmd" class="text-green/90 text-[11px]">yay -S gaur-bin</code>
        </div>
        <button id="copy-btn" class="px-4 py-1 text-[10px] font-bold border border-mauve text-mauve hover:bg-mauve/10 transition-all rounded-sm uppercase tracking-widest">
            COPY
        </button>
    </div>
  </div>
</div>

<script>
  const allPackages = [
    { source: 'extra', name: 'firefox', version: '133.0-1', desc: 'Fast, Private & Safe Web Browser' },
    { source: 'extra', name: 'firefox-i18n-af', version: '133.0-1', desc: 'Afrikaans language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-an', version: '133.0-1', desc: 'Aragonese language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-ar', version: '133.0-1', desc: 'Arabic language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-az', version: '133.0-1', desc: 'Azerbaijani language pack for Firefox' },
    { source: 'aur', name: 'firefoxpwa', version: '2.18.0.1', desc: 'A system to use Firefox as a PWA' },
    { source: 'extra', name: 'librewolf', version: '132.0-1', desc: 'Community-maintained fork of Firefox' },
    { source: 'extra', name: 'chromium', version: '131.0-1', desc: 'A web browser built for speed' }
  ];

  const wait = (ms: number) => new Promise(res => setTimeout(res, ms));

  async function runAnimation() {
    const inputEl = document.getElementById('typing-input');
    const listEl = document.getElementById('package-list');
    const statusEl = document.getElementById('search-status');
    const pkgCountEl = document.getElementById('pkg-count');
    const aurCountEl = document.getElementById('aur-count');

    if (!inputEl || !listEl || !statusEl || !pkgCountEl || !aurCountEl) return;
    
    await wait(800);

    const filter = "a:";
    for (let i = 0; i <= filter.length; i++) {
      const q = filter.slice(0, i);
      inputEl.textContent = q;
      updateFilterHints(q);
      await wait(150);
    }
    await wait(300);

    const query = "firefox";
    for (let i = 0; i <= query.length; i++) {
      const currentQuery = filter + query.slice(0, i);
      inputEl.textContent = currentQuery;
      updateFilterHints(currentQuery);
      
      const filteredCount = updateList(currentQuery);
      pkgCountEl.textContent = filteredCount.toString();
      aurCountEl.textContent = Math.floor(filteredCount * 0.8).toString();
      
      if (i > 0) statusEl.classList.add('opacity-100');
      await wait(100 + Math.random() * 100);
    }

    await wait(400);
    focusPackage(0); 
    await wait(600);
    markPackage(0);
    await wait(500);
    focusPackage(1);
    await wait(300);
    markPackage(1);
  }

  function updateFilterHints(q: string) {
      const hints = document.querySelectorAll('#filter-hints span');
      hints.forEach(hint => {
          const filter = (hint as HTMLElement).dataset.filter;
          if (filter && q.includes(filter)) {
              hint.classList.remove('text-surface2');
              if (filter === 'c:') hint.classList.add('text-green', 'font-bold');
              if (filter === 'e:') hint.classList.add('text-blue', 'font-bold');
              if (filter === 'm:') hint.classList.add('text-yellow', 'font-bold');
              if (filter === 'a:') hint.classList.add('text-pink', 'font-bold');
          } else {
              hint.classList.add('text-surface2');
              hint.classList.remove('text-green', 'text-blue', 'text-yellow', 'text-pink', 'font-bold');
          }
      });
  }

  function updateList(q: string) {
    const listEl = document.getElementById('package-list');
    const summaryEl = document.getElementById('repo-summary');
    if (!listEl || !summaryEl) return 0;
    
    const actualQuery = q.includes(':') ? q.split(':')[1] : q;
    const activeFilters = q.includes(':') ? [q.split(':')[0]] : [];

    const filtered = allPackages.filter(p => {
        const matchesQuery = p.name.includes(actualQuery);
        if (activeFilters.length > 0) {
            const filterChar = activeFilters[0];
            if (filterChar === 'a' && p.source !== 'aur') return false;
            if (filterChar === 'e' && p.source !== 'extra') return false;
        }
        return matchesQuery;
    }).slice(0, 6);

    listEl.innerHTML = '';
    
    filtered.forEach((pkg, idx) => {
      const div = document.createElement('div');
      div.className = 'pkg-item flex items-center px-0 py-0 transition-all duration-150 w-full';
      div.innerHTML = `
        <span class="pointer text-sapphire font-bold w-3 inline-block text-center"> </span><span class="marker text-subtext0 w-2 inline-block"> </span><span class="text-${pkg.source === 'aur' ? 'pink' : 'blue'}">${pkg.source}</span><span class="text-overlay1">/</span><span class="text-text font-semibold">${pkg.name}</span>
        <span class="text-subtext1 ml-auto mr-3">${pkg.version}</span>
      `;
      div.id = `pkg-${idx}`;
      listEl.appendChild(div);
    });

    const counts = filtered.reduce((acc: any, p) => {
        acc[p.source] = (acc[p.source] || 0) + 1;
        return acc;
    }, {});
    
    summaryEl.innerHTML = Object.entries(counts).map(([repo, count]) => {
        const color = repo === 'aur' ? 'text-pink' : 'text-blue';
        return `<span>${count} <span class="${color}">${repo}</span></span>`;
    }).join(', ');

    return filtered.length * 10 + Math.floor(Math.random() * 10);
  }

  function focusPackage(idx: number) {
    const items = document.querySelectorAll('.pkg-item');
    items.forEach((item, i) => {
      const pointer = item.querySelector('.pointer');
      const marker = item.querySelector('.marker');
      if (i === idx) {
        item.classList.add('bg-surface0');
        if (pointer) pointer.textContent = '>';
        if (marker && marker.textContent === ' ') {
            marker.classList.add('w-2');
            marker.textContent = ' ';
        }
      } else {
        item.classList.remove('bg-surface0');
        if (pointer) pointer.textContent = ' ';
      }
    });
    updateDetails(idx);
  }

  function updateDetails(idx: number) {
    const q = document.getElementById('typing-input')?.textContent || "";
    const filtered = allPackages.filter(p => p.name.includes(q.includes(':') ? q.split(':')[1] : q));
    const pkg = filtered[idx];
    const pane = document.getElementById('details-pane');
    if (!pkg || !pane) return;

    pane.classList.add('opacity-100');
    document.getElementById('detail-repo')!.textContent = pkg.source;
    document.getElementById('detail-name')!.textContent = pkg.name;
    document.getElementById('detail-version')!.textContent = pkg.version;
    document.getElementById('detail-desc')!.textContent = pkg.desc;
  }

  const marked = new Set();
  function markPackage(idx: number) {
    const q = document.getElementById('typing-input')?.textContent || "";
    const filtered = allPackages.filter(p => p.name.includes(q.includes(':') ? q.split(':')[1] : q));
    const pkg = filtered[idx];
    if (!pkg) return;

    const item = document.getElementById(`pkg-${idx}`);
    const marker = item?.querySelector('.marker');
    
    if (marker) {
        marker.textContent = '*';
        marker.classList.remove('w-2');
        marker.classList.add('w-auto');
    }
    
    marked.add(pkg.name);
    updateSelectionPane();
  }

  function updateSelectionPane() {
    const pane = document.getElementById('selection-pane');
    const list = document.getElementById('selected-items');
    const count = document.getElementById('select-count');
    if (!pane || !list || !count) return;

    pane.classList.add('opacity-100');
    count.textContent = marked.size.toString();
    list.innerHTML = Array.from(marked).map(name => `<div>${name}</div>`).join('');
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const cmd = target.dataset.cmd;
        
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'text-mauve');
            b.classList.add('text-subtext0');
        });
        target.classList.add('active', 'text-mauve');
        target.classList.remove('text-subtext0');

        const cmdEl = document.getElementById('install-cmd');
        if (cmdEl && cmd) cmdEl.textContent = cmd;
    });
  });

  const copyBtn = document.getElementById('copy-btn');
  copyBtn?.addEventListener('click', () => {
      const cmd = document.getElementById('install-cmd')?.textContent;
      if (cmd) {
          navigator.clipboard.writeText(cmd);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'DONE';
          copyBtn.classList.replace('text-mauve', 'text-green');
          copyBtn.classList.replace('border-mauve', 'border-green');
          
          setTimeout(() => {
              copyBtn.textContent = originalText;
              copyBtn.classList.replace('text-green', 'text-mauve');
              copyBtn.classList.replace('border-green', 'border-mauve');
          }, 2000);
      }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runAnimation();
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  const container = document.getElementById('terminal-container');
  if (container) observer.observe(container);
</script>
