---
---
<div class="w-full max-w-4xl mx-auto px-4 mt-12 mb-20 font-mono">
  <div id="terminal-container" class="relative group">
    <!-- Elevated Border Shadow Effect -->
    <div class="absolute -inset-0.5 bg-sapphire/10 rounded-gaur blur opacity-10 group-hover:opacity-30 transition duration-1000 group-hover:duration-200"></div>
    
    <!-- Main Terminal Window -->
    <div class="relative bg-base border border-surface1/60 rounded-gaur overflow-hidden shadow-2xl transition-all duration-300 hover:border-sapphire/30">
      
      <!-- TUI Content Area (Reduced padding) -->
      <div class="p-3 md:p-5 aspect-[16/10] flex flex-col gap-0 text-[11px] md:text-xs overflow-hidden relative text-text">
        
        <!-- Selection Pane (ABSOLUTE OVERLAY - Same Font Size) -->
        <div id="selection-pane" class="absolute top-5 right-5 w-44 border border-pink/40 rounded-sm p-3 bg-mantle/95 backdrop-blur-md z-20 transform translate-x-4 opacity-0 transition-all duration-500 shadow-2xl">
          <div class="text-pink font-bold mb-2 uppercase tracking-wider">Selected (<span id="select-count">0</span>) [*]</div>
          <div id="selected-items" class="space-y-1 text-subtext0 leading-tight">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Top Section: Details Pane (Reduced Outer Gap) -->
        <div class="h-[42%] border border-blue/30 rounded-sm p-4 relative bg-surface0/20 mb-3">
          <div id="details-pane" class="opacity-0 transition-opacity duration-300 text-left">
            <div class="grid grid-cols-[100px_1fr] gap-x-2 gap-y-1">
              <span class="text-subtext0">Repository</span> <span id="detail-repo" class="text-blue"></span>
              <span class="text-subtext0">Name</span> <span id="detail-name" class="font-bold"></span>
              <span class="text-subtext0">Version</span> <span id="detail-version" class="text-subtext1"></span>
              <span class="text-subtext0">Description</span> <span id="detail-desc" class="text-text/90"></span>
              <span class="text-subtext0">Architecture</span> <span class="text-subtext1/70">x86_64</span>
              <span class="text-subtext0">URL</span> <span class="text-sapphire underline decoration-sapphire/30 truncate">https://www.mozilla.org/firefox/</span>
            </div>
          </div>
        </div>

        <!-- Bottom Section: Package List (No Left Padding) -->
        <div class="flex-grow border border-sapphire/30 rounded-sm p-0 flex flex-col justify-end relative bg-surface0/10">
          <div class="p-4 flex flex-col justify-end h-full">
              <!-- Scrolling List -->
              <div id="package-list" class="flex flex-col-reverse gap-1 mb-2 overflow-hidden">
                <!-- Populated by JS -->
              </div>
              
              <!-- Search Progress / Status -->
              <div id="search-status" class="text-[10px] text-subtext0 mb-2 opacity-0 transition-opacity">
                Found <span id="pkg-count">0</span> packages (<span id="aur-count">0</span> from AUR)
              </div>

              <!-- Input Line -->
              <div class="flex items-center gap-2 border-t border-surface1/40 pt-3">
                <span class="text-green font-bold">&gt;</span>
                <span id="typing-input" class="text-text font-bold min-w-[1px]"></span>
                <span id="cursor" class="w-1.5 h-4 bg-text/50 animate-pulse"></span>
              </div>
          </div>
        </div>

        <!-- Shortcuts Bar -->
        <div class="flex justify-center gap-4 mt-4 text-[10px] text-overlay2 tracking-tight">
          <span>[/] search</span>
          <span>[tab] mark</span>
          <span class="text-blue font-bold">[i]nstall</span>
          <span>[d]ash</span>
          <span>[r]emove</span>
          <span>[u]pdate</span>
          <span>[q]uit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Install Command Bar (The Tabs) -->
  <div class="mt-8 max-w-2xl mx-auto">
    <div class="flex gap-2 px-4 mb-2">
        <button class="tab-btn active text-[10px] font-bold text-mauve tracking-widest uppercase transition-all hover:text-mauve" data-cmd="yay -S gaur-bin">
            [ yay ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="paru -S gaur-bin">
            [ paru ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="go install github.com/prbhtkumr/gaur@latest">
            [ go ]
        </button>
    </div>
    <div class="bg-crust border border-surface0 rounded-gaur p-4 flex items-center justify-between group shadow-xl">
        <div class="flex items-center gap-3">
            <span class="text-green font-bold">$</span>
            <code id="install-cmd" class="text-green/90 text-[11px]">yay -S gaur-bin</code>
        </div>
        <button id="copy-btn" class="px-4 py-1 text-[10px] font-bold border border-mauve text-mauve hover:bg-mauve/10 transition-all rounded-sm uppercase tracking-widest">
            COPY
        </button>
    </div>
  </div>
</div>

<script>
  const allPackages = [
    { source: 'extra', name: 'firefox', version: '133.0-1', desc: 'Fast, Private & Safe Web Browser' },
    { source: 'extra', name: 'firefox-i18n-af', version: '133.0-1', desc: 'Afrikaans language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-an', version: '133.0-1', desc: 'Aragonese language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-ar', version: '133.0-1', desc: 'Arabic language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-az', version: '133.0-1', desc: 'Azerbaijani language pack for Firefox' },
    { source: 'aur', name: 'firefoxpwa', version: '2.18.0.1', desc: 'A system to use Firefox as a PWA' },
    { source: 'extra', name: 'librewolf', version: '132.0-1', desc: 'Community-maintained fork of Firefox' },
    { source: 'extra', name: 'chromium', version: '131.0-1', desc: 'A web browser built for speed' }
  ];

  const wait = (ms: number) => new Promise(res => setTimeout(res, ms));

  async function runAnimation() {
    const inputEl = document.getElementById('typing-input');
    const listEl = document.getElementById('package-list');
    const statusEl = document.getElementById('search-status');
    const pkgCountEl = document.getElementById('pkg-count');
    const aurCountEl = document.getElementById('aur-count');

    if (!inputEl || !listEl || !statusEl || !pkgCountEl || !aurCountEl) return;
    
    await wait(800);

    const query = "firefox";
    for (let i = 0; i <= query.length; i++) {
      const currentQuery = query.slice(0, i);
      inputEl.textContent = currentQuery;
      
      const filteredCount = updateList(currentQuery);
      pkgCountEl.textContent = filteredCount.toString();
      aurCountEl.textContent = Math.floor(filteredCount * 0.8).toString();
      
      if (i > 0) statusEl.classList.add('opacity-100');
      await wait(100 + Math.random() * 100);
    }

    await wait(400);
    focusPackage(0); 
    await wait(600);
    markPackage(0);
    await wait(500);
    focusPackage(1);
    await wait(300);
    markPackage(1);
  }

  function updateList(q: string) {
    const listEl = document.getElementById('package-list');
    if (!listEl) return 0;
    
    const filtered = allPackages.filter(p => p.name.includes(q)).slice(0, 6);
    listEl.innerHTML = '';
    
    filtered.forEach((pkg, idx) => {
      const div = document.createElement('div');
      div.className = 'pkg-item flex items-center gap-2 px-0 py-0.5 rounded-sm transition-all duration-150';
      div.innerHTML = `
        <span class="cursor-marker opacity-0 text-sapphire font-bold">&gt;</span>
        <span class="mark-marker text-subtext0 w-2"> </span>
        <span class="text-${pkg.source === 'aur' ? 'pink' : 'blue'}">${pkg.source}</span><span class="text-overlay1">/</span><span class="text-text font-semibold">${pkg.name}</span>
        <span class="text-subtext1 ml-auto">${pkg.version}</span>
      `;
      div.id = `pkg-${idx}`;
      listEl.appendChild(div);
    });

    const totalFound = filtered.length * 10 + Math.floor(Math.random() * 10);
    return totalFound;
  }

  function focusPackage(idx: number) {
    const items = document.querySelectorAll('.pkg-item');
    items.forEach((item, i) => {
      const marker = item.querySelector('.cursor-marker');
      if (i === idx) {
        item.classList.add('bg-surface0');
        if (marker) marker.classList.remove('opacity-0');
        updateDetails(idx);
      } else {
        item.classList.remove('bg-surface0');
        if (marker) marker.classList.add('opacity-0');
      }
    });
  }

  function updateDetails(idx: number) {
    const q = document.getElementById('typing-input')?.textContent || "";
    const filtered = allPackages.filter(p => p.name.includes(q));
    const pkg = filtered[idx];
    const pane = document.getElementById('details-pane');
    if (!pkg || !pane) return;

    pane.classList.add('opacity-100');
    document.getElementById('detail-repo')!.textContent = pkg.source;
    document.getElementById('detail-name')!.textContent = pkg.name;
    document.getElementById('detail-version')!.textContent = pkg.version;
    document.getElementById('detail-desc')!.textContent = pkg.desc;
  }

  const marked = new Set();
  function markPackage(idx: number) {
    const q = document.getElementById('typing-input')?.textContent || "";
    const filtered = allPackages.filter(p => p.name.includes(q));
    const pkg = filtered[idx];
    if (!pkg) return;

    const item = document.getElementById(`pkg-${idx}`);
    const markMarker = item?.querySelector('.mark-marker');
    if (markMarker) markMarker.textContent = '*';
    marked.add(pkg.name);

    updateSelectionPane();
  }

  function updateSelectionPane() {
    const pane = document.getElementById('selection-pane');
    const list = document.getElementById('selected-items');
    const count = document.getElementById('select-count');
    if (!pane || !list || !count) return;

    pane.classList.remove('translate-x-4', 'opacity-0');
    count.textContent = marked.size.toString();
    list.innerHTML = Array.from(marked).map(name => `<div>${name}</div>`).join('');
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const cmd = target.dataset.cmd;
        
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'text-mauve');
            b.classList.add('text-subtext0');
        });
        target.classList.add('active', 'text-mauve');
        target.classList.remove('text-subtext0');

        const cmdEl = document.getElementById('install-cmd');
        if (cmdEl && cmd) cmdEl.textContent = cmd;
    });
  });

  const copyBtn = document.getElementById('copy-btn');
  copyBtn?.addEventListener('click', () => {
      const cmd = document.getElementById('install-cmd')?.textContent;
      if (cmd) {
          navigator.clipboard.writeText(cmd);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'DONE';
          copyBtn.classList.replace('text-mauve', 'text-green');
          copyBtn.classList.replace('border-mauve', 'border-green');
          
          setTimeout(() => {
              copyBtn.textContent = originalText;
              copyBtn.classList.replace('text-green', 'text-mauve');
              copyBtn.classList.replace('border-green', 'border-mauve');
          }, 2000);
      }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runAnimation();
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  const container = document.getElementById('terminal-container');
  if (container) observer.observe(container);
</script>
