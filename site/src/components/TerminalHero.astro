---
---
<div class="w-full max-w-4xl mx-auto px-4 mt-12 mb-20 font-mono">
  <div id="terminal-container" class="relative group">
    <!-- Elevated Border Shadow Effect -->
    <div class="absolute -inset-0.5 bg-highlight/10 rounded-gaur blur opacity-10 group-hover:opacity-30 transition duration-1000 group-hover:duration-200"></div>
    
    <!-- Main Terminal Window -->
    <div class="relative bg-background border border-muted/20 rounded-gaur overflow-hidden shadow-2xl transition-all duration-300 hover:border-highlight/30">
      
      <!-- TUI Content Area -->
      <div class="p-4 md:p-8 aspect-[16/10] flex flex-col gap-0 text-sm md:text-base overflow-hidden relative">
        
        <!-- Selection Pane (ABSOLUTE OVERLAY) -->
        <div id="selection-pane" class="absolute top-8 right-8 w-48 border border-pink/40 rounded-sm p-3 bg-surface/95 backdrop-blur-md z-20 transform translate-x-4 opacity-0 transition-all duration-500 shadow-2xl">
          <div class="text-pink font-bold mb-2 text-[11px] uppercase tracking-wider">Selected (<span id="select-count">0</span>) [*]</div>
          <div id="selected-items" class="space-y-1 text-[11px] text-muted leading-tight">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Top Section: Details Pane -->
        <div class="h-[45%] border border-blue/30 rounded-sm p-5 relative bg-surface/20 mb-6">
          <div id="details-pane" class="opacity-0 transition-opacity duration-300 text-left">
            <div class="grid grid-cols-[120px_1fr] gap-x-3 gap-y-1.5 text-[13px] md:text-sm">
              <span class="text-muted">Repository</span> <span id="detail-repo" class="text-blue"></span>
              <span class="text-muted">Name</span> <span id="detail-name" class="font-bold"></span>
              <span class="text-muted">Version</span> <span id="detail-version" class="text-muted"></span>
              <span class="text-muted">Description</span> <span id="detail-desc" class="text-text/90"></span>
              <span class="text-muted">Architecture</span> <span class="text-text/70">x86_64</span>
              <span class="text-muted">URL</span> <span class="text-highlight underline decoration-highlight/30 truncate">https://www.mozilla.org/firefox/</span>
            </div>
          </div>
        </div>

        <!-- Bottom Section: Package List -->
        <div class="flex-grow border border-highlight/30 rounded-sm p-5 bg-surface/20 flex flex-col justify-end relative">
          <!-- Scrolling List -->
          <div id="package-list" class="flex flex-col-reverse gap-1.5 mb-3 overflow-hidden">
            <!-- Populated by JS -->
          </div>
          
          <!-- Search Progress / Status (Fixed logic) -->
          <div id="search-status" class="text-[11px] text-muted mb-3 opacity-0 transition-opacity">
            Found <span id="pkg-count">0</span> packages (<span id="aur-count">0</span> from AUR)
          </div>

          <!-- Input Line -->
          <div class="flex items-center gap-2 border-t border-muted/10 pt-4">
            <span class="text-accent font-bold">&gt;</span>
            <span id="typing-input" class="text-text font-bold min-w-[1px] text-[13px] md:text-sm"></span>
            <span id="cursor" class="w-2 h-5 bg-text/50 animate-pulse"></span>
          </div>
        </div>

        <!-- Shortcuts Bar -->
        <div class="flex justify-center gap-6 mt-6 text-[11px] text-muted/60 tracking-tight">
          <span>[/] search</span>
          <span>[tab] mark</span>
          <span class="text-blue/80 font-bold">[i]nstall</span>
          <span>[d]ash</span>
          <span>[r]emove</span>
          <span>[u]pdate</span>
          <span>[q]uit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Install Command Bar -->
  <div class="mt-10 max-w-2xl mx-auto">
    <div class="flex gap-4 px-4 mb-3">
        <button class="tab-btn active text-[11px] font-bold text-primary tracking-widest uppercase transition-all hover:text-primary" data-cmd="yay -S gaur-bin">
            [ yay ]
        </button>
        <button class="tab-btn text-[11px] font-bold text-muted tracking-widest uppercase transition-all hover:text-primary" data-cmd="paru -S gaur-bin">
            [ paru ]
        </button>
        <button class="tab-btn text-[11px] font-bold text-muted tracking-widest uppercase transition-all hover:text-primary" data-cmd="go install github.com/prbhtkumr/gaur@latest">
            [ go ]
        </button>
    </div>
    <div class="bg-crust border border-muted/20 rounded-gaur p-5 flex items-center justify-between group shadow-xl">
        <div class="flex items-center gap-4">
            <span class="text-accent font-bold">$</span>
            <code id="install-cmd" class="text-accent/90 text-sm">yay -S gaur-bin</code>
        </div>
        <button id="copy-btn" class="px-5 py-1.5 text-[11px] font-bold border border-primary text-primary hover:bg-primary/10 transition-all rounded-sm uppercase tracking-widest">
            COPY
        </button>
    </div>
  </div>
</div>

<script>
  const allPackages = [
    { source: 'extra', name: 'firefox', version: '133.0-1', desc: 'Fast, Private & Safe Web Browser' },
    { source: 'extra', name: 'firefox-i18n-af', version: '133.0-1', desc: 'Afrikaans language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-an', version: '133.0-1', desc: 'Aragonese language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-ar', version: '133.0-1', desc: 'Arabic language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-az', version: '133.0-1', desc: 'Azerbaijani language pack for Firefox' },
    { source: 'aur', name: 'firefoxpwa', version: '2.18.0.1', desc: 'A system to use Firefox as a PWA' },
    { source: 'extra', name: 'librewolf', version: '132.0-1', desc: 'Community-maintained fork of Firefox' },
    { source: 'extra', name: 'chromium', version: '131.0-1', desc: 'A web browser built for speed' }
  ];

  const wait = (ms: number) => new Promise(res => setTimeout(res, ms));

  async function runAnimation() {
    const inputEl = document.getElementById('typing-input');
    const listEl = document.getElementById('package-list');
    const statusEl = document.getElementById('search-status');
    const pkgCountEl = document.getElementById('pkg-count');
    const aurCountEl = document.getElementById('aur-count');

    if (!inputEl || !listEl || !statusEl || !pkgCountEl || !aurCountEl) return;
    
    await wait(800);

    const query = "firefox";
    for (let i = 0; i <= query.length; i++) {
      const currentQuery = query.slice(0, i);
      inputEl.textContent = currentQuery;
      
      const filteredCount = updateList(currentQuery);
      pkgCountEl.textContent = filteredCount.toString();
      aurCountEl.textContent = Math.floor(filteredCount * 0.8).toString(); // Make it make sense (AUR <= Total)
      
      if (i > 0) statusEl.classList.add('opacity-100');
      await wait(100 + Math.random() * 100);
    }

    await wait(400);
    focusPackage(0); 
    await wait(600);
    markPackage(0);
    await wait(500);
    focusPackage(1);
    await wait(300);
    markPackage(1);
  }

  function updateList(q: string) {
    const listEl = document.getElementById('package-list');
    if (!listEl) return 0;
    
    const filtered = allPackages.filter(p => p.name.includes(q)).slice(0, 6);
    listEl.innerHTML = '';
    
    filtered.forEach((pkg, idx) => {
      const div = document.createElement('div');
      div.className = 'pkg-item flex items-center gap-2 px-2 py-0.5 rounded-sm transition-all duration-150 text-[13px] md:text-sm';
      div.innerHTML = `
        <span class="cursor-marker opacity-0 text-highlight font-bold">&gt;</span>
        <span class="mark-marker text-muted w-2"> </span>
        <span class="text-${pkg.source === 'aur' ? 'pink' : 'blue'}">${pkg.source}</span><span class="text-text/40">/</span><span class="text-text font-semibold">${pkg.name}</span>
        <span class="text-muted ml-auto">${pkg.version}</span>
      `;
      div.id = `pkg-${idx}`;
      listEl.appendChild(div);
    });

    // Logical count simulation
    const totalFound = filtered.length * 10 + Math.floor(Math.random() * 10);
    return totalFound;
  }

  function focusPackage(idx: number) {
    const items = document.querySelectorAll('.pkg-item');
    items.forEach((item, i) => {
      const marker = item.querySelector('.cursor-marker');
      if (i === idx) {
        item.classList.add('bg-white/5');
        if (marker) marker.classList.remove('opacity-0');
        updateDetails(idx);
      } else {
        item.classList.remove('bg-white/5');
        if (marker) marker.classList.add('opacity-0');
      }
    });
  }

  function updateDetails(idx: number) {
    const q = document.getElementById('typing-input')?.textContent || "";
    const filtered = allPackages.filter(p => p.name.includes(q));
    const pkg = filtered[idx];
    const pane = document.getElementById('details-pane');
    if (!pkg || !pane) return;

    pane.classList.add('opacity-100');
    document.getElementById('detail-repo')!.textContent = pkg.source;
    document.getElementById('detail-name')!.textContent = pkg.name;
    document.getElementById('detail-version')!.textContent = pkg.version;
    document.getElementById('detail-desc')!.textContent = pkg.desc;
  }

  const marked = new Set();
  function markPackage(idx: number) {
    const q = document.getElementById('typing-input')?.textContent || "";
    const filtered = allPackages.filter(p => p.name.includes(q));
    const pkg = filtered[idx];
    if (!pkg) return;

    const item = document.getElementById(`pkg-${idx}`);
    const markMarker = item?.querySelector('.mark-marker');
    if (markMarker) markMarker.textContent = '*';
    marked.add(pkg.name);

    updateSelectionPane();
  }

  function updateSelectionPane() {
    const pane = document.getElementById('selection-pane');
    const list = document.getElementById('selected-items');
    const count = document.getElementById('select-count');
    if (!pane || !list || !count) return;

    pane.classList.remove('translate-x-4', 'opacity-0');
    count.textContent = marked.size.toString();
    list.innerHTML = Array.from(marked).map(name => `<div>${name}</div>`).join('');
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const cmd = target.dataset.cmd;
        
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'text-primary');
            b.classList.add('text-muted');
        });
        target.classList.add('active', 'text-primary');
        target.classList.remove('text-muted');

        const cmdEl = document.getElementById('install-cmd');
        if (cmdEl && cmd) cmdEl.textContent = cmd;
    });
  });

  const copyBtn = document.getElementById('copy-btn');
  copyBtn?.addEventListener('click', () => {
      const cmd = document.getElementById('install-cmd')?.textContent;
      if (cmd) {
          navigator.clipboard.writeText(cmd);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'DONE';
          copyBtn.classList.replace('text-primary', 'text-accent');
          copyBtn.classList.replace('border-primary', 'border-accent');
          
          setTimeout(() => {
              copyBtn.textContent = originalText;
              copyBtn.classList.replace('text-accent', 'text-primary');
              copyBtn.classList.replace('border-accent', 'border-primary');
          }, 2000);
      }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runAnimation();
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  const container = document.getElementById('terminal-container');
  if (container) observer.observe(container);
</script>
