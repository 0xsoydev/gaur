---
---
<div class="w-full max-w-4xl mx-auto px-4 mt-6 mb-4 font-mono text-[11px] md:text-xs">
  <div id="terminal-container" class="relative group">
    <!-- Elevated Border Shadow Effect (ROUNDED) -->
    <div class="absolute -inset-0.5 bg-sapphire/10 rounded-xl blur opacity-10 group-hover:opacity-30 transition duration-1000 group-hover:duration-200"></div>
    
    <!-- Main Terminal Window -->
    <div class="relative bg-base border border-surface1/60 rounded-xl overflow-hidden shadow-2xl min-h-[540px] md:h-[540px] flex flex-col">
      
      <!-- TUI Content Area -->
      <div class="grow flex flex-col gap-0 overflow-hidden relative text-text">
        
        <!-- Top Section: Details Pane (ROUNDED) -->
        <div class="mx-3 mt-3 h-1/2 border border-blue/30 rounded-gaur relative">
          <!-- Selection Pane (ABSOLUTE OVERLAY - Anchored to border) -->
          <div id="selection-pane" class="absolute -top-[1px] -right-[1px] min-w-[15ch] max-w-[20ch] md:max-w-[25ch] w-fit border border-pink/40 rounded-gaur p-2 md:p-3 bg-base z-20 opacity-0 transition-all duration-500 text-left">
            <div class="text-pink font-bold mb-1 md:mb-2 tracking-tight flex justify-between items-center gap-2 md:gap-4 text-[10px] md:text-xs">
                <span>Selected (<span id="select-count">0</span>)</span>
                <span class="text-[10px]">[*]</span>
            </div>
            <div id="selected-items" class="space-y-0 text-text/90 leading-tight break-all text-[9px] md:text-[10px]">
              <!-- Populated by JS -->
            </div>
          </div>

          <div id="details-scroller" class="h-full p-4 overflow-y-auto overflow-x-hidden">
            <div id="details-pane" class="opacity-0 transition-opacity duration-300 text-left">
              <div class="grid grid-cols-[80px_10px_1fr] md:grid-cols-[110px_10px_1fr] gap-x-0 gap-y-0.5">
                <span class="text-text">Repository</span> <span class="text-text/60">:</span> <span id="detail-repo" class="text-blue"></span>
                <span class="text-text">Name</span> <span class="text-text/60">:</span> <span id="detail-name" class="font-bold"></span>
                <span class="text-text">Version</span> <span class="text-text/60">:</span> <span id="detail-version" class="text-text"></span>
                <span class="text-text">Description</span> <span class="text-text/60">:</span> <span id="detail-desc" class="text-text/90"></span>
                <span class="text-text">Architecture</span> <span class="text-text/60">:</span> <span class="text-text">x86_64</span>
                <span class="text-text">URL</span> <span class="text-text/60">:</span> <span class="text-text underline decoration-text/30 truncate">https://www.mozilla.org/firefox/</span>
                <span class="text-text">Licenses</span> <span class="text-text/60">:</span> <span class="text-text">MPL-2.0</span>
                <span class="text-text">Groups</span> <span class="text-text/60">:</span> <span class="text-text">None</span>
                <span class="text-text">Provides</span> <span class="text-text/60">:</span> <span class="text-text">None</span>
                <span class="text-text truncate">Depends On</span> <span class="text-text/60">:</span> <span class="text-text leading-tight">alsa-lib at-spi2-core bash cairo dbus ffmpeg fontconfig freetype2 gdk-pixbuf2 glib2 glibc gtk3 hicolor-icon-theme libgcc libpulse libstdc++ libx11 libxcb libxcomposite libxdamage libxext libxfixes libxrandr libxss libxt mime-types</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Bottom Section: Package List (ROUNDED) -->
        <div class="mx-3 h-1/2 border border-blue/30 rounded-gaur flex flex-col justify-end relative mt-3 mb-2 overflow-hidden">
          <!-- Scrolling List -->
          <div id="package-list" class="flex flex-col-reverse gap-0.5 mb-2 overflow-y-auto overflow-x-hidden w-full relative">
            <!-- Populated by JS -->
            <div class="absolute right-1 top-0 bottom-0 w-1 bg-surface1/10 rounded-full hidden md:block">
                <div class="h-24 w-full bg-surface2/30 rounded-full"></div>
            </div>
          </div>
          
          <!-- Input Area -->
          <div class="border-t border-surface1/40 shrink-0">
              <!-- Input Line -->
              <div class="flex items-center justify-between pt-2 pl-3 pr-3">
                <div class="flex items-center gap-2">
                    <span class="text-text font-bold">&gt;</span>
                    <span id="typing-input" class="text-text font-bold min-w-[1px]"></span>
                    <span id="cursor" class="w-2 h-4 bg-text/80"></span>
                </div>
                <!-- Filter Hinting -->
                <div id="filter-hints" class="text-[10px] text-surface2 flex gap-2 md:gap-3">
                    <span data-filter="c:">c:</span>
                    <span data-filter="e:">e:</span>
                    <span data-filter="m:">m:</span>
                    <span data-filter="a:">a:</span>
                </div>
              </div>
              
              <!-- Search Status -->
              <div id="search-status" class="text-[10px] text-subtext0 pb-2 pl-3 pr-3 opacity-0 transition-opacity flex flex-wrap items-center justify-between gap-x-4">
                <div class="flex items-center gap-2">
                  <span id="search-indicator" class="text-blue min-w-[1ch]"></span>
                  <span id="search-text" class="italic"></span>
                </div>
                <div id="repo-summary" class="flex gap-2 text-[9px] md:text-[10px]">
                    <!-- Populated by JS -->
                </div>
              </div>
          </div>
        </div>
      </div>

      <!-- Shortcuts Bar -->
      <div class="flex justify-center items-center px-4 py-2 text-[9px] md:text-[10px] text-overlay2 tracking-tight">
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-1">
            <span>[/]:search</span>
            <span>[tab]:mark</span>
            <span>[d]ash</span>
            <span class="text-blue font-bold tracking-wider">[i]nstall</span>
            <span>[u]pdate</span>
            <span>[r]emove</span>
            <span>[,]:settings</span>
            <span>[q]uit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Install Command Bar (ROUNDED) -->
  <div class="mt-4 max-w-2xl mx-auto">
    <div class="flex flex-wrap gap-4 px-4 mb-2 justify-center md:justify-start">
        <button class="tab-btn active text-[10px] font-bold text-mauve tracking-widest uppercase transition-all hover:text-mauve" data-cmd="paru -S gaur-bin">
            [ paru ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="yay -S gaur-bin">
            [ yay ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="go install github.com/prbhtkumr/gaur@latest">
            [ go ]
        </button>
    </div>
    <div class="bg-crust border border-surface0 rounded-gaur p-3 md:p-4 flex flex-col md:flex-row items-center justify-between group shadow-xl gap-4">
        <div class="flex items-center gap-3 w-full md:w-auto">
            <span class="text-green font-bold">$</span>
            <code id="install-cmd" class="text-green/90 text-[11px] break-all">paru -S gaur-bin</code>
        </div>
        <button id="copy-btn" class="w-full md:w-auto px-6 py-2 md:py-1 text-[10px] font-bold border border-mauve text-mauve hover:bg-mauve/10 transition-all rounded-gaur uppercase tracking-widest">
            COPY
        </button>
    </div>
  </div>
</div>

<script>
  const allPackages = [
    { source: 'extra', name: 'firefox', version: '133.0.3-1', desc: 'Fast, Private & Safe Web Browser' },
    { source: 'extra', name: 'firefox-i18n-af', version: '133.0.3-1', desc: 'Afrikaans language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-ar', version: '133.0.3-1', desc: 'Arabic language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-be', version: '133.0.3-1', desc: 'Belarusian language pack for Firefox' },
    { source: 'extra', name: 'firefox-developer-edition', version: '134.0b1-1', desc: 'Developer Edition of Firefox' },
    { source: 'extra', name: 'firefox-nightly-bin', version: '135.0a1-1', desc: 'Nightly build of Firefox' },
    { source: 'aur', name: 'firefoxpwa', version: '2.18.2-1', desc: 'A system to use Firefox as a PWA' },
    { source: 'aur', name: 'zen-browser-bin', version: '1.0.0-a.42-1', desc: 'Experience tranquility while browsing the web without losing speed. Firefox based browser with vertical tabs.' },
    { source: 'aur', name: 'zen-browser-avx2-bin', version: '1.0.0-a.42-1', desc: 'Zen Browser (AVX2 optimized) - precompiled binaries' },
    { source: 'aur', name: 'zen-browser-patched-bin', version: '1.0.0-1', desc: 'Patched version of zen browser' },
    { source: 'aur', name: 'zenity-git', version: '3.99-1', desc: 'Display GTK+ dialogs' },
    { source: 'aur', name: 'zengarden', version: '0.1-1', desc: 'Zen garden theme' },
    { source: 'core', name: 'linux', version: '6.12.1.arch1-1', desc: 'The Linux kernel and modules' },
    { source: 'core', name: 'linux-headers', version: '6.12.1.arch1-1', desc: 'Headers and scripts for building modules for the Mainline kernel' },
    { source: 'core', name: 'linux-lts', version: '6.6.63-1', desc: 'The Linux-LTS kernel and modules' },
    { source: 'extra', name: 'linux-firmware', version: '20241118.9d3568b-1', desc: 'Firmware files for Linux' },
    { source: 'aur', name: 'linux-zen', version: '6.12.1.zen1-1', desc: 'The Linux-ZEN kernel and modules' },
    { source: 'aur', name: 'linux-mainline', version: '6.13rc1-1', desc: 'The Mainline Linux kernel and modules' },
    { source: 'multilib', name: 'flash-lib32', version: '32.0-1', desc: 'Flash library' },
    { source: 'core', name: 'filesystem', version: '2024.11.22-1', desc: 'Base Arch Linux files' }
  ];

  const wait = (ms: number) => new Promise(res => setTimeout(res, ms));

  let currentFocusIdx = -1;
  let selectionFocusedIdx = -1;
  const marked = new Set();
  let isSelectionMode = false;

  async function runAnimation() {
    const inputEl = document.getElementById('typing-input');
    const listEl = document.getElementById('package-list');
    const statusEl = document.getElementById('search-status');
    const indicatorEl = document.getElementById('search-indicator');
    const searchTextEl = document.getElementById('search-text');

    if (!inputEl || !listEl || !statusEl || !indicatorEl || !searchTextEl) return;
    
    // Reset state
    marked.clear();
    updateSelectionPane();
    currentFocusIdx = -1;
    selectionFocusedIdx = -1;
    isSelectionMode = false;
    updateDetails(-1);

    // Initial state
    updateList("");
    statusEl.classList.add('opacity-100');
    searchTextEl.textContent = "Loaded 14285 packages";
    await wait(1000);

    // Type "/"
    await wait(500);

    // Search: firefox
    const query1 = "firefox";
    for (let i = 0; i <= query1.length; i++) {
      const q = query1.slice(0, i);
      inputEl.textContent = q;
      updateFilterHints(q);
      const count = updateList(q);
      updateSearchStatus(q, count);
      await wait(400);
    }
    await wait(800);

    // Tab, Up, Tab...
    await focusPackage(0); await wait(400);
    markPackage(0); await wait(500);
    await focusPackage(1); await wait(500);
    markPackage(1); await wait(500);
    await focusPackage(2); await wait(500);
    markPackage(2); await wait(500);
    await focusPackage(1); await wait(500);
    markPackage(1); // Toggle off
    await wait(500);

    // Backspace query
    for (let i = query1.length; i >= 0; i--) {
      const q = query1.slice(0, i);
      inputEl.textContent = q;
      updateFilterHints(q);
      const count = updateList(q);
      updateSearchStatus(q, count);
      await wait(100);
    }
    await wait(500);

    // Type "zen browser"
    const query2 = "zen browser";
    for (let i = 0; i <= query2.length; i++) {
      const q = query2.slice(0, i);
      inputEl.textContent = q;
      updateFilterHints(q);
      const count = updateList(q);
      updateSearchStatus(q, count);
      await wait(400);
    }
    await wait(800);

    // Tab (Select zen-browser-bin), Escape (Clear details)
    await focusPackage(0); await wait(500);
    markPackage(0); await wait(500);
    await focusPackage(-1); await wait(500);

    // Type "*" (Focus Selection Pane)
    inputEl.textContent = "*";
    isSelectionMode = true;
    updateSelectionPane();
    await wait(500);
    
    // Down (Navigate selection pane to firefox-i18n-ar)
    await focusSelectionItem(0); await wait(500);
    await focusSelectionItem(1); await wait(500);
    
    // Tab (Unselect focused item: firefox-i18n-ar)
    markPackage(-1); 
    await wait(500);
    
    // Escape (Exit selection mode)
    isSelectionMode = false;
    selectionFocusedIdx = -1;
    updateSelectionPane();
    await focusPackage(-1);
    await wait(500);

    // Type "/" then Backspace 11
    inputEl.textContent = "/"; await wait(200);
    inputEl.textContent = ""; await wait(500);

    // Type "linux"
    const query3 = "linux";
    for (let i = 0; i <= query3.length; i++) {
      const q = query3.slice(0, i);
      inputEl.textContent = q;
      updateFilterHints(q);
      const count = updateList(q);
      updateSearchStatus(q, count);
      await wait(400);
    }
    await wait(500);

    // Ctrl+a + m: 
    inputEl.textContent = "m: linux";
    updateFilterHints("m: linux");
    updateList("m: linux");
    await wait(500);

    // e: 
    inputEl.textContent = "e: linux";
    updateFilterHints("e: linux");
    updateList("e: linux");
    await wait(500);

    // Up 25, Tab
    await focusPackage(0); await wait(500);
    markPackage(0); await wait(500);

    // a: 
    inputEl.textContent = "a: linux";
    updateFilterHints("a: linux");
    updateList("a: linux");
    await wait(2000);

    // Up 25, Tab
    await focusPackage(0); await wait(500);
    markPackage(0); await wait(2000);
  }

  function updateSearchStatus(q: string, count: number) {
    const searchTextEl = document.getElementById('search-text');
    if (!searchTextEl) return;
    if (q === "") {
        searchTextEl.textContent = "Loaded 14285 packages";
    } else if (q.length >= 2 || isSelectionMode) {
        searchTextEl.textContent = `AUR search complete. Found ${count} matches.`;
    } else {
        searchTextEl.textContent = "";
    }
  }

  function updateFilterHints(q: string) {
      const hints = document.querySelectorAll('#filter-hints span');
      hints.forEach(hint => {
          const filter = (hint as HTMLElement).dataset.filter;
          if (filter && q.includes(filter)) {
              hint.classList.remove('text-surface2');
              if (filter === 'c:') hint.classList.add('text-green', 'font-bold');
              if (filter === 'e:') hint.classList.add('text-blue', 'font-bold');
              if (filter === 'm:') hint.classList.add('text-yellow', 'font-bold');
              if (filter === 'a:') hint.classList.add('text-pink', 'font-bold');
          } else {
              hint.classList.add('text-surface2');
              hint.classList.remove('text-green', 'text-blue', 'text-yellow', 'text-pink', 'font-bold');
          }
      });
  }

  function updateList(q: string) {
    const listEl = document.getElementById('package-list');
    const summaryEl = document.getElementById('repo-summary');
    if (!listEl || !summaryEl) return 0;
    
    let actualQuery = q.includes(':') ? q.split(':')[1] : q;
    actualQuery = actualQuery.trim().toLowerCase().replace(/\s+/g, '-');
    const activeFilters = q.includes(':') ? [q.split(':')[0].trim()] : [];

    const filtered = allPackages.filter(p => {
        const name = p.name.toLowerCase();
        const matchesQuery = (actualQuery !== "" && name.includes(actualQuery));
        if (activeFilters.length > 0) {
            const f = activeFilters[0];
            if (f === 'a' && p.source !== 'aur') return false;
            if (f === 'e' && p.source !== 'extra') return false;
            if (f === 'm' && p.source !== 'multilib') return false;
            if (f === 'c' && p.source !== 'core') return false;
            return actualQuery === "" || matchesQuery;
        }
        return actualQuery === "" ? false : matchesQuery;
    });

    const displayList = (actualQuery === "" && activeFilters.length === 0) ? [] : filtered.slice(0, 12);
    const counts: Record<string, number> = {};
    const countSource = (actualQuery === "" && activeFilters.length === 0) ? allPackages : filtered;
    countSource.forEach(p => { counts[p.source] = (counts[p.source] || 0) + 1; });

    let summaryHTML = '';
    const sortedSources = ['core', 'extra', 'multilib', 'aur'].filter(s => counts[s]);
    sortedSources.forEach((source, idx) => {
        let colorClass = 'text-blue';
        if (source === 'aur') colorClass = 'text-pink';
        if (source === 'core') colorClass = 'text-green';
        if (source === 'multilib') colorClass = 'text-yellow';
        summaryHTML += `<span>${counts[source]} <span class="${colorClass}">${source}</span></span>`;
        if (idx < sortedSources.length - 1) summaryHTML += '<span>, </span>';
    });
    summaryEl.innerHTML = summaryHTML;

    listEl.innerHTML = '';
    displayList.forEach((pkg, idx) => {
      const div = document.createElement('div');
      div.className = 'pkg-item flex items-center px-3 py-0 transition-all duration-150 w-full font-medium';
      const sourceColorClass = pkg.source === 'aur' ? 'text-pink' : 'text-blue';
      const isMarked = marked.has(pkg.name);
      div.innerHTML = `
        <span class="indicator text-pink font-bold w-4 flex-shrink-0">${isMarked ? '*' : ''}</span>
        <span class="${sourceColorClass}">${pkg.source}</span>
        <span class="text-overlay1">/</span>
        <span class="text-text">${getHighlightedName(pkg.name, actualQuery)}</span>
        <span class="text-overlay1/50 ml-auto">${pkg.version}</span>
      `;
      div.id = `pkg-${idx}`;
      listEl.appendChild(div);
    });
    return filtered.length;
  }

  function getHighlightedName(name: string, query: string) {
    if (!query) return name;
    const nq = query.toLowerCase().replace(/\s+/g, '');
    const res = [];
    let qi = 0;
    for (let i = 0; i < name.length; i++) {
        if (qi < nq.length && name[i].toLowerCase() === nq[qi]) {
            res.push(`<span class="text-yellow font-bold">${name[i]}</span>`);
            qi++;
        } else { res.push(name[i]); }
    }
    return res.join('');
  }

  async function focusPackage(idx: number) {
    if (isSelectionMode) return;
    currentFocusIdx = idx;
    const items = document.querySelectorAll('.pkg-item');
    items.forEach((item, i) => {
      const indicator = item.querySelector('.indicator');
      const isMarked = indicator?.textContent?.includes('*');
      if (i === idx) {
        item.classList.add('bg-surface1/20');
        if (indicator) indicator.textContent = '>' + (isMarked ? '*' : '');
      } else {
        item.classList.remove('bg-surface1/20');
        if (indicator) indicator.textContent = isMarked ? '*' : '';
      }
    });
    updateDetails(idx);
  }

  async function focusSelectionItem(idx: number) {
      selectionFocusedIdx = idx;
      updateSelectionPane();

      const markedList = Array.from(marked);
      const pkgName = markedList[idx];
      const paneDetails = document.getElementById('details-pane');
      if (!paneDetails) return;

      if (!pkgName || idx === -1) {
          paneDetails.classList.replace('opacity-100', 'opacity-0');
      } else {
          const pkg = allPackages.find(p => p.name === pkgName);
          if (pkg) {
              paneDetails.classList.replace('opacity-0', 'opacity-100');
              document.getElementById('detail-repo')!.textContent = pkg.source;
              document.getElementById('detail-name')!.textContent = pkg.name;
              document.getElementById('detail-version')!.textContent = pkg.version;
              document.getElementById('detail-desc')!.textContent = pkg.desc;
          }
      }
  }

  function getFilteredPackages() {
    const q = document.getElementById('typing-input')?.textContent || "";
    let actualQuery = q.includes(':') ? q.split(':')[1] : q;
    actualQuery = actualQuery.trim().toLowerCase().replace(/\s+/g, '-');
    const activeFilters = q.includes(':') ? [q.split(':')[0].trim()] : [];
    return allPackages.filter(p => {
        const name = p.name.toLowerCase();
        const matchesQuery = name.includes(actualQuery) || actualQuery === "";
        if (activeFilters.length > 0) {
            const f = activeFilters[0];
            if (f === 'a' && p.source !== 'aur') return false;
            if (f === 'e' && p.source !== 'extra') return false;
            if (f === 'm' && p.source !== 'multilib') return false;
            if (f === 'c' && p.source !== 'core') return false;
        }
        return matchesQuery;
    });
  }

  function updateDetails(idx: number) {
    if (isSelectionMode) return;
    const filtered = getFilteredPackages();
    const pkg = filtered[idx];
    const pane = document.getElementById('details-pane');
    if (!pane) return;
    if (!pkg || idx === -1) {
        pane.classList.replace('opacity-100', 'opacity-0');
    } else {
        pane.classList.replace('opacity-0', 'opacity-100');
        document.getElementById('detail-repo')!.textContent = pkg.source;
        document.getElementById('detail-name')!.textContent = pkg.name;
        document.getElementById('detail-version')!.textContent = pkg.version;
        document.getElementById('detail-desc')!.textContent = pkg.desc;
    }
  }

  function markPackage(idx: number) {
    if (isSelectionMode) {
        const markedList = Array.from(marked);
        const nameToRemove = markedList[selectionFocusedIdx];
        if (nameToRemove) marked.delete(nameToRemove);
    } else {
        const filtered = getFilteredPackages();
        const pkg = filtered[idx];
        if (!pkg) return;
        if (marked.has(pkg.name)) { marked.delete(pkg.name); } else { marked.add(pkg.name); }
    }
    
    updateSelectionPane();
    if (isSelectionMode) {
        if (marked.size === 0) {
            isSelectionMode = false;
            selectionFocusedIdx = -1;
            updateDetails(-1);
        } else {
            // Adjust index if we removed the last item
            if (selectionFocusedIdx >= marked.size) selectionFocusedIdx = marked.size - 1;
            focusSelectionItem(selectionFocusedIdx);
        }
    }
    const q = document.getElementById('typing-input')?.textContent || "";
    updateList(q);
    if (!isSelectionMode && currentFocusIdx !== -1) focusPackage(currentFocusIdx);
  }

  function updateSelectionPane() {
    const pane = document.getElementById('selection-pane');
    const list = document.getElementById('selected-items');
    const countEl = document.getElementById('select-count');
    if (!pane || !list || !countEl) return;

    countEl.textContent = marked.size.toString();

    if (marked.size > 0 || isSelectionMode) {
        pane.classList.add('opacity-100');
        list.innerHTML = Array.from(marked).map((name, i) => {
            const isFocused = isSelectionMode && i === selectionFocusedIdx;
            const prefix = isFocused ? "> " : "  ";
            return `<div class="${isFocused ? 'text-peach' : ''} whitespace-pre">${prefix}${name}</div>`;
        }).join('');
    } else {
        pane.classList.remove('opacity-100');
    }
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        const t = e.currentTarget as HTMLButtonElement;
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'text-mauve');
            b.classList.add('text-subtext0');
        });
        t.classList.add('active', 'text-mauve');
        t.classList.remove('text-subtext0');
        const cmdEl = document.getElementById('install-cmd');
        if (cmdEl && t.dataset.cmd) cmdEl.textContent = t.dataset.cmd;
    });
  });

  const copyBtn = document.getElementById('copy-btn');
  copyBtn?.addEventListener('click', () => {
      const cmd = document.getElementById('install-cmd')?.textContent;
      if (cmd) {
          navigator.clipboard.writeText(cmd);
          const ot = copyBtn.textContent;
          copyBtn.textContent = 'DONE';
          copyBtn.classList.replace('text-mauve', 'text-green');
          copyBtn.classList.replace('border-mauve', 'border-green');
          setTimeout(() => {
              copyBtn.textContent = ot;
              copyBtn.classList.replace('text-green', 'text-mauve');
              copyBtn.classList.replace('border-green', 'border-mauve');
          }, 2000);
      }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { runAnimation(); observer.unobserve(entry.target); }
    });
  }, { threshold: 0.5 });

  const container = document.getElementById('terminal-container');
  if (container) observer.observe(container);
</script>
