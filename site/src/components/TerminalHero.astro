---
---
<div class="w-full max-w-4xl mx-auto px-4 mt-6 mb-4 font-mono text-[11px] md:text-xs">
  <div id="terminal-container" class="relative group">
    <!-- Elevated Border Shadow Effect (ROUNDED) -->
    <div class="absolute -inset-0.5 bg-sapphire/10 rounded-xl blur opacity-10 group-hover:opacity-30 transition duration-1000 group-hover:duration-200"></div>
    
    <!-- Main Terminal Window -->
    <div class="relative bg-base border border-surface1/60 rounded-xl overflow-hidden shadow-2xl h-[540px] flex flex-col">
      
      <!-- TUI Content Area -->
      <div class="grow flex flex-col gap-0 overflow-hidden relative text-text">
        
        <!-- Top Section: Details Pane (ROUNDED) -->
        <div class="mx-3 mt-3 h-1/2 border border-blue/30 rounded-gaur p-4 relative">
          <!-- Selection Pane (ABSOLUTE OVERLAY - Anchored to border) -->
          <div id="selection-pane" class="absolute -top-[1px] -right-[1px] min-w-[15ch] max-w-[25ch] w-fit border border-pink/40 rounded-gaur p-3 bg-base z-20 opacity-0 transition-opacity duration-500 text-left">
            <div class="text-pink font-bold mb-2 tracking-tight flex justify-between items-center gap-4">
                <span>Selected (2)</span>
                <span class="text-[10px]">[*]</span>
            </div>
            <div id="selected-items" class="space-y-1 text-text/90 leading-tight break-all">
              <!-- Populated by JS -->
            </div>
          </div>

          <div id="details-pane" class="opacity-0 transition-opacity duration-300 text-left">
            <div class="grid grid-cols-[110px_10px_1fr] gap-x-0 gap-y-0.5">
              <span class="text-text">Repository</span> <span class="text-text/60">:</span> <span id="detail-repo" class="text-blue"></span>
              <span class="text-text">Name</span> <span class="text-text/60">:</span> <span id="detail-name" class="font-bold"></span>
              <span class="text-text">Version</span> <span class="text-text/60">:</span> <span id="detail-version" class="text-text"></span>
              <span class="text-text">Description</span> <span class="text-text/60">:</span> <span id="detail-desc" class="text-text/90"></span>
              <span class="text-text">Architecture</span> <span class="text-text/60">:</span> <span class="text-text">x86_64</span>
              <span class="text-text">URL</span> <span class="text-text/60">:</span> <span class="text-text underline decoration-text/30 truncate">https://www.mozilla.org/firefox/</span>
              <span class="text-text">Licenses</span> <span class="text-text/60">:</span> <span class="text-text">MPL-2.0</span>
              <span class="text-text">Groups</span> <span class="text-text/60">:</span> <span class="text-text">None</span>
              <span class="text-text">Provides</span> <span class="text-text/60">:</span> <span class="text-text">None</span>
              <span class="text-text">Depends On</span> <span class="text-text/60">:</span> <span class="text-text leading-tight">alsa-lib at-spi2-core bash cairo dbus ffmpeg fontconfig freetype2 gdk-pixbuf2 glib2 glibc gtk3 hicolor-icon-theme libgcc libpulse libstdc++ libx11 libxcb libxcomposite libxdamage libxext libxfixes libxrandr libxss libxt mime-types</span>
            </div>
          </div>
        </div>

        <!-- Bottom Section: Package List (ROUNDED) -->
        <div class="mx-3 h-1/2 border border-blue/30 rounded-gaur flex flex-col justify-end relative mt-3 mb-2 overflow-hidden">
          <!-- Scrolling List -->
          <div id="package-list" class="flex flex-col-reverse gap-0.5 mb-2 overflow-hidden w-full relative">
            <!-- Populated by JS -->
            <div class="absolute right-1 top-0 bottom-0 w-1 bg-surface1/10 rounded-full">
                <div class="h-24 w-full bg-surface2/30 rounded-full"></div>
            </div>
          </div>
          
          <!-- Input Area -->
          <div class="border-t border-surface1/40">
              <!-- Input Line -->
              <div class="flex items-center justify-between pt-2 pl-3 pr-3">
                <div class="flex items-center gap-2">
                    <span class="text-text font-bold">&gt;</span>
                    <span id="typing-input" class="text-text font-bold min-w-[1px]"></span>
                    <span id="cursor" class="w-2 h-4 bg-text/80"></span>
                </div>
                <!-- Filter Hinting -->
                <div id="filter-hints" class="text-[10px] text-surface2 flex gap-3">
                    <span data-filter="c:">c:</span>
                    <span data-filter="e:">e:</span>
                    <span data-filter="m:">m:</span>
                    <span data-filter="a:">a:</span>
                </div>
              </div>
              
              <!-- Search Status -->
              <div id="search-status" class="text-[10px] text-subtext0 pb-2 pl-3 pr-3 opacity-0 transition-opacity flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span id="search-indicator" class="text-blue min-w-[1ch]"></span>
                  <span id="search-text" class="italic"></span>
                </div>
                <div id="repo-summary" class="flex gap-2">
                    <!-- Populated by JS -->
                </div>
              </div>
          </div>
        </div>
      </div>

      <!-- Shortcuts Bar -->
      <div class="flex justify-center items-center px-4 py-2 text-[9px] md:text-[10px] text-overlay2 tracking-tight">
        <div class="flex gap-5">
            <span>[/]:search</span>
            <span>[tab]:mark</span>
            <span>[d]ash</span>
            <span class="text-blue font-bold tracking-wider">[i]nstall</span>
            <span>[u]pdate</span>
            <span>[r]emove</span>
            <span>[,]:settings</span>
            <span>[q]uit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Install Command Bar (ROUNDED) -->
  <div class="mt-4 max-w-2xl mx-auto">
    <div class="flex gap-4 px-4 mb-2">
        <button class="tab-btn active text-[10px] font-bold text-mauve tracking-widest uppercase transition-all hover:text-mauve" data-cmd="paru -S gaur-bin">
            [ paru ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="yay -S gaur-bin">
            [ yay ]
        </button>
        <button class="tab-btn text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="go install github.com/prbhtkumr/gaur@latest">
            [ go ]
        </button>
    </div>
    <div class="bg-crust border border-surface0 rounded-gaur p-4 flex items-center justify-between group shadow-xl">
        <div class="flex items-center gap-3">
            <span class="text-green font-bold">$</span>
            <code id="install-cmd" class="text-green/90 text-[11px]">paru -S gaur-bin</code>
        </div>
        <button id="copy-btn" class="px-4 py-1 text-[10px] font-bold border border-mauve text-mauve hover:bg-mauve/10 transition-all rounded-sm uppercase tracking-widest">
            COPY
        </button>
    </div>
  </div>
</div>

<script>
  const allPackages = [
    { source: 'extra', name: 'firefox', version: '133.0.3-1', desc: 'Fast, Private & Safe Web Browser' },
    { source: 'extra', name: 'firefox-i18n-af', version: '133.0.3-1', desc: 'Afrikaans language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-ar', version: '133.0.3-1', desc: 'Arabic language pack for Firefox' },
    { source: 'extra', name: 'firefox-i18n-be', version: '133.0.3-1', desc: 'Belarusian language pack for Firefox' },
    { source: 'extra', name: 'firefox-developer-edition', version: '134.0b1-1', desc: 'Developer Edition of Firefox' },
    { source: 'extra', name: 'firefox-nightly-bin', version: '135.0a1-1', desc: 'Nightly build of Firefox' },
    { source: 'extra', name: 'firefox-focus', version: '133.0-1', desc: 'Privacy browser' },
    { source: 'extra', name: 'firefox-adblock', version: '1.0-1', desc: 'Adblock for firefox' },
    { source: 'extra', name: 'firefox-extension-privacy-badger', version: '2024.7.17-1', desc: 'Privacy Badger' },
    { source: 'core', name: 'filesystem', version: '2024.11.22-1', desc: 'Base Arch Linux files' },
    { source: 'core', name: 'findutils', version: '4.10.0-1', desc: 'GNU find, xargs, and locate' },
    { source: 'core', name: 'flex', version: '2.6.4-5', desc: 'Fast lexical analyzer generator' },
    { source: 'core', name: 'fzip', version: '1.0-1', desc: 'Fast zip' },
    { source: 'multilib', name: 'fbg-lib32', version: '1.2-1', desc: '32-bit library' },
    { source: 'multilib', name: 'flash-lib32', version: '32.0-1', desc: 'Flash library' },
    { source: 'aur', name: 'firefoxpwa', version: '2.18.2-1', desc: 'A system to use Firefox as a PWA' },
    { source: 'aur', name: 'zen-browser-bin', version: '1.0.0-a.42-1', desc: 'Experience tranquility while browsing the web without losing speed. Firefox based browser with vertical tabs.' },
    { source: 'aur', name: 'zen-browser-avx2-bin', version: '1.0.0-a.42-1', desc: 'Zen Browser (AVX2 optimized) - precompiled binaries' },
    { source: 'aur', name: 'zen-browser-patched-bin', version: '1.0.0-1', desc: 'Patched version of zen browser' },
    { source: 'aur', name: 'zenity-git', version: '3.99-1', desc: 'Display GTK+ dialogs' },
    { source: 'aur', name: 'zengarden', version: '0.1-1', desc: 'Zen garden theme' },
    { source: 'extra', name: 'librewolf', version: '133.0-1', desc: 'Community-maintained fork of Firefox' },
    { source: 'extra', name: 'chromium', version: '131.0.6778.85-1', desc: 'A web browser built for speed' }
  ];

  const wait = (ms: number) => new Promise(res => setTimeout(res, ms));

  async function runAnimation() {
    const inputEl = document.getElementById('typing-input');
    const listEl = document.getElementById('package-list');
    const statusEl = document.getElementById('search-status');
    const indicatorEl = document.getElementById('search-indicator');
    const searchTextEl = document.getElementById('search-text');

    if (!inputEl || !listEl || !statusEl || !indicatorEl || !searchTextEl) return;
    
    // Initial state: Loaded packages
    updateList("");
    statusEl.classList.add('opacity-100');
    searchTextEl.textContent = "Loaded 14285 packages";
    
    await wait(1500);

    // Initial search: firefox
    const query1 = "firefox";
    for (let i = 0; i <= query1.length; i++) {
      const currentQuery = query1.slice(0, i);
      inputEl.textContent = currentQuery;
      updateFilterHints(currentQuery);
      updateList(currentQuery);
      
      if (currentQuery.length >= 3) {
        searchTextEl.textContent = `Searching AUR for "${currentQuery}"...`;
        // Show spinner
        indicatorEl.textContent = '⣾';
      } else if (currentQuery.length > 0) {
        searchTextEl.textContent = "";
        indicatorEl.textContent = "";
      } else {
        searchTextEl.textContent = "Loaded 14285 packages";
        indicatorEl.textContent = "";
      }
      await wait(80 + Math.random() * 100);
    }

    // Braille Animation (0.6 seconds)
    const brailleChars = ['⣾', '⣽', '⣻', '⢿', '⡿', '⣟', '⣯', '⣷'];
    let startTime = Date.now();
    let frame = 0;
    while (Date.now() - startTime < 600) {
      indicatorEl.textContent = brailleChars[frame % brailleChars.length];
      frame++;
      await wait(80);
    }

    // Search Complete
    indicatorEl.textContent = '';
    searchTextEl.textContent = 'AUR search complete. Took 0.62 seconds.';
    updateList(query1);

    await wait(400);
    focusPackage(0); 
    await wait(300);
    markPackage(0);
    await wait(400);
    focusPackage(1);
    await wait(250);
    markPackage(1);
    await wait(400);

    // Backspace query
    for (let i = query1.length; i >= 0; i--) {
      const currentQuery = query1.slice(0, i);
      inputEl.textContent = currentQuery;
      updateFilterHints(currentQuery);
      updateList(currentQuery);
      
      if (currentQuery.length >= 3) {
        searchTextEl.textContent = `Searching AUR for "${currentQuery}"...`;
      } else if (currentQuery.length > 0) {
        searchTextEl.textContent = "";
      } else {
        searchTextEl.textContent = "Loaded 14285 packages";
      }
      await wait(50);
    }
    await wait(500);

    // New search: a: zen browser
    const filter = "a: ";
    for (let i = 0; i <= filter.length; i++) {
      const q = filter.slice(0, i);
      inputEl.textContent = q;
      updateFilterHints(q);
      updateList(q);
      searchTextEl.textContent = "";
      await wait(100);
    }
    
    const query2 = "zen browser";
    for (let i = 0; i <= query2.length; i++) {
      const currentQuery = filter + query2.slice(0, i);
      const searchQuery = query2.slice(0, i).trim();
      inputEl.textContent = currentQuery;
      updateFilterHints(currentQuery);
      updateList(currentQuery);
      
      if (searchQuery.length >= 3) {
        searchTextEl.textContent = `Searching AUR for "${searchQuery}"...`;
        indicatorEl.textContent = '⣾';
      } else {
        searchTextEl.textContent = "";
        indicatorEl.textContent = "";
      }
      await wait(80 + Math.random() * 80);
    }

    // Braille Animation (1.1 seconds)
    startTime = Date.now();
    frame = 0;
    while (Date.now() - startTime < 1100) {
      indicatorEl.textContent = brailleChars[frame % brailleChars.length];
      frame++;
      await wait(80);
    }

    indicatorEl.textContent = '';
    searchTextEl.textContent = 'AUR search complete. Took 1.12 seconds.';
    updateList(filter + query2);

    await wait(500);
    focusPackage(0);
    await wait(600);
    markPackage(0);
  }

  function updateFilterHints(q: string) {
      const hints = document.querySelectorAll('#filter-hints span');
      hints.forEach(hint => {
          const filter = (hint as HTMLElement).dataset.filter;
          if (filter && q.includes(filter)) {
              hint.classList.remove('text-surface2');
              if (filter === 'c:') hint.classList.add('text-green', 'font-bold');
              if (filter === 'e:') hint.classList.add('text-blue', 'font-bold');
              if (filter === 'm:') hint.classList.add('text-yellow', 'font-bold');
              if (filter === 'a:') hint.classList.add('text-pink', 'font-bold');
          } else {
              hint.classList.add('text-surface2');
              hint.classList.remove('text-green', 'text-blue', 'text-yellow', 'text-pink', 'font-bold');
          }
      });
  }

  function updateList(q: string) {
    const listEl = document.getElementById('package-list');
    const summaryEl = document.getElementById('repo-summary');
    if (!listEl || !summaryEl) return 0;
    
    let actualQuery = q.includes(':') ? q.split(':')[1] : q;
    actualQuery = actualQuery.trim().toLowerCase().replace(/\s+/g, '-');
    const activeFilters = q.includes(':') ? [q.split(':')[0].trim()] : [];

    const filtered = allPackages.filter(p => {
        const name = p.name.toLowerCase();
        // Only return matches if there is an actual query, or if a specific repo filter is active
        const matchesQuery = (actualQuery !== "" && name.includes(actualQuery));
        
        if (activeFilters.length > 0) {
            const filterChar = activeFilters[0];
            if (filterChar === 'a' && p.source !== 'aur') return false;
            if (filterChar === 'e' && p.source !== 'extra') return false;
            // If we have a filter but no query, we might still show packages in that repo
            // but for gaur, it usually waits for some input or shows nothing if search is blank
            return actualQuery === "" || matchesQuery;
        }
        return matchesQuery;
    });

    // If query and filters are empty, show nothing in the list (gaur behavior)
    const displayList = (actualQuery === "" && activeFilters.length === 0) ? [] : filtered.slice(0, 9);
    
    // Count sources from the ALL filtered results (if no query, show total counts)
    const counts: Record<string, number> = {};
    const countSource = (actualQuery === "" && activeFilters.length === 0) ? allPackages : filtered;
    countSource.forEach(p => {
        counts[p.source] = (counts[p.source] || 0) + 1;
    });

    // Update summary
    let summaryHTML = '';
    const sortedSources = Object.keys(counts).sort();
    
    if (sortedSources.length > 0) {
        sortedSources.forEach((source, idx) => {
            let colorClass = 'text-blue'; // default
            if (source === 'aur') colorClass = 'text-pink';
            if (source === 'core') colorClass = 'text-green';
            if (source === 'multilib') colorClass = 'text-orange';
            
            summaryHTML += `<span>${counts[source]} <span class="${colorClass}">${source}</span></span>`;
            if (idx < sortedSources.length - 1) {
                summaryHTML += '<span>, </span>';
            }
        });
    }
    summaryEl.innerHTML = summaryHTML;

    listEl.innerHTML = '';
    
    displayList.forEach((pkg, idx) => {
      const div = document.createElement('div');
      div.className = 'pkg-item flex items-center px-3 py-0 transition-all duration-150 w-full font-medium';
      
      const sourceColorClass = pkg.source === 'aur' ? 'text-pink' : 'text-blue';
      const highlightedName = getHighlightedName(pkg.name, actualQuery);
      
      div.innerHTML = `
        <span class="indicator text-pink font-bold w-4 flex-shrink-0"></span>
        <span class="${sourceColorClass}">${pkg.source}</span>
        <span class="text-overlay1">/</span>
        <span class="text-text">${highlightedName}</span>
        <span class="text-overlay1/50 ml-auto">${pkg.version}</span>
      `;
      div.id = `pkg-${idx}`;
      listEl.appendChild(div);
    });

    return filtered.length;
  }

  function getHighlightedName(name: string, query: string) {
    if (!query) return name;
    
    const normalizedQuery = query.toLowerCase().replace(/\s+/g, '');
    const result: string[] = [];
    let queryIdx = 0;
    
    // Simple fuzzy highlight: highlight characters in the order they appear in the query
    for (let i = 0; i < name.length; i++) {
        const char = name[i];
        if (queryIdx < normalizedQuery.length && char.toLowerCase() === normalizedQuery[queryIdx]) {
            result.push(`<span class="text-yellow font-bold">${char}</span>`);
            queryIdx++;
        } else {
            result.push(char);
        }
    }
    return result.join('');
  }

  function focusPackage(idx: number) {
    const items = document.querySelectorAll('.pkg-item');
    items.forEach((item, i) => {
      const indicator = item.querySelector('.indicator');
      if (i === idx) {
        item.classList.add('bg-surface1/20');
        if (indicator) {
            const currentText = indicator.textContent || "";
            indicator.textContent = '>' + (currentText.includes('*') ? '*' : '');
        }
      } else {
        item.classList.remove('bg-surface1/20');
        if (indicator) {
            const currentText = indicator.textContent || "";
            indicator.textContent = currentText.includes('*') ? '*' : '';
        }
      }
    });
    updateDetails(idx);
  }

  function getFilteredPackages() {
    const q = document.getElementById('typing-input')?.textContent || "";
    let actualQuery = q.includes(':') ? q.split(':')[1] : q;
    actualQuery = actualQuery.trim().toLowerCase().replace(/\s+/g, '-');
    const activeFilters = q.includes(':') ? [q.split(':')[0].trim()] : [];

    return allPackages.filter(p => {
        const name = p.name.toLowerCase();
        const matchesQuery = name.includes(actualQuery) || actualQuery === "";
        
        if (activeFilters.length > 0) {
            const filterChar = activeFilters[0];
            if (filterChar === 'a' && p.source !== 'aur') return false;
            if (filterChar === 'e' && p.source !== 'extra') return false;
        }
        return matchesQuery;
    });
  }

  function updateDetails(idx: number) {
    const filtered = getFilteredPackages();
    const pkg = filtered[idx];
    const pane = document.getElementById('details-pane');
    if (!pkg || !pane) return;

    pane.classList.add('opacity-100');
    document.getElementById('detail-repo')!.textContent = pkg.source;
    document.getElementById('detail-name')!.textContent = pkg.name;
    document.getElementById('detail-version')!.textContent = pkg.version;
    document.getElementById('detail-desc')!.textContent = pkg.desc;
  }

  const marked = new Set();
  function markPackage(idx: number) {
    const filtered = getFilteredPackages();
    const pkg = filtered[idx];
    if (!pkg) return;

    const item = document.getElementById(`pkg-${idx}`);
    const indicator = item?.querySelector('.indicator');
    
    if (indicator) {
        const currentText = indicator.textContent || "";
        if (!currentText.includes('*')) {
            indicator.textContent = currentText + '*';
        }
    }
    
    marked.add(pkg.name);
    updateSelectionPane();
  }

  function updateSelectionPane() {
    const pane = document.getElementById('selection-pane');
    const list = document.getElementById('selected-items');
    const count = document.getElementById('select-count');
    if (!pane || !list) return;

    pane.classList.add('opacity-100');
    list.innerHTML = Array.from(marked).map(name => `<div>${name}</div>`).join('');
  }

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const cmd = target.dataset.cmd;
        
        document.querySelectorAll('.tab-btn').forEach(b => {
            b.classList.remove('active', 'text-mauve');
            b.classList.add('text-subtext0');
        });
        target.classList.add('active', 'text-mauve');
        target.classList.remove('text-subtext0');

        const cmdEl = document.getElementById('install-cmd');
        if (cmdEl && cmd) cmdEl.textContent = cmd;
    });
  });

  const copyBtn = document.getElementById('copy-btn');
  copyBtn?.addEventListener('click', () => {
      const cmd = document.getElementById('install-cmd')?.textContent;
      if (cmd) {
          navigator.clipboard.writeText(cmd);
          const originalText = copyBtn.textContent;
          copyBtn.textContent = 'DONE';
          copyBtn.classList.replace('text-mauve', 'text-green');
          copyBtn.classList.replace('border-mauve', 'border-green');
          
          setTimeout(() => {
              copyBtn.textContent = originalText;
              copyBtn.classList.replace('text-green', 'text-mauve');
              copyBtn.classList.replace('border-green', 'border-mauve');
          }, 2000);
      }
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runAnimation();
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });

  const container = document.getElementById('terminal-container');
  if (container) observer.observe(container);
</script>
