---
import Layout from '../layouts/Layout.astro';

const themes = [
    { name: 'Catppuccin Frappe', img: '/gaur/screenshots/catppuccin-frappe.png' },
    { name: 'Catppuccin Macchiato', img: '/gaur/screenshots/catppuccin-macchiato.png' },
    { name: 'Catppuccin Mocha', img: '/gaur/screenshots/catppuccin-mocha.png' },
    { name: 'Dracula', img: '/gaur/screenshots/dracula.png' },
    { name: 'Gruvbox Dark', img: '/gaur/screenshots/gruvbox-dark.png' },
    { name: 'Monokai Pro', img: '/gaur/screenshots/monokai-pro.png' },
    { name: 'One Dark', img: '/gaur/screenshots/one-dark.png' },
    { name: 'Rose Pine', img: '/gaur/screenshots/rose-pine.png' },
    { name: 'Solarized Dark', img: '/gaur/screenshots/solarized-dark.png' },
    { name: 'Tokyo Night Night', img: '/gaur/screenshots/tokyonight-night.png' },
    { name: 'Tokyo Night Storm', img: '/gaur/screenshots/tokyonight-storm.png' },
];
---

<Layout title="Gaur - Theme Gallery">
	<div class="max-w-6xl mx-auto px-4 py-20">
		<header class="text-center mb-20">
			<h1 class="text-4xl md:text-6xl font-bold mb-4">
				<span class="text-primary">Theme</span> Gallery
			</h1>
			<p class="text-muted text-lg max-w-2xl mx-auto">
				Gaur supports many popular terminal themes out of the box. 
				Configure your terminal to match for the ultimate ricing experience.
			</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-12">
			{themes.map((theme) => (
				<div class="group relative">
					<!-- Hover Effect Background -->
					<div class="absolute -inset-1 bg-highlight/20 rounded-gaur blur opacity-0 group-hover:opacity-40 transition duration-500"></div>
					
					<div class="relative bg-surface border border-muted/20 rounded-gaur overflow-hidden transition-all duration-300 group-hover:border-highlight/50 shadow-xl group-hover:shadow-glow">
						<!-- Custom ASCII Header for Card -->
						<div class="px-4 py-2 border-b border-muted/10 bg-crust/50 flex items-center justify-between">
							<span class="text-[10px] text-muted font-bold tracking-widest uppercase">{theme.name}</span>
							<div class="flex gap-1">
								<div class="w-1.5 h-1.5 rounded-full bg-muted/20"></div>
								<div class="w-1.5 h-1.5 rounded-full bg-muted/20"></div>
							</div>
						</div>
						
						<div class="p-2">
							<img 
								src={theme.img} 
								alt={`${theme.name} theme in Gaur`} 
								class="w-full h-auto rounded-sm shadow-inner"
								loading="lazy"
							/>
						</div>
					</div>
				</div>
			))}
		</div>

		<div class="mt-20 text-center border-t border-muted/10 pt-12">
			<p class="text-muted text-sm italic">
				&gt; Missing your favorite theme? Feel free to open a PR!
			</p>
		</div>
	</div>
</Layout>
