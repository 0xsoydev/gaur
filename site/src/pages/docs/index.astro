---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';

const docsEntries = await getCollection('docs');

// Sort them so Installation is first, then Usage, etc.
const order = ['installation', 'usage', 'configuration', 'internals'];
docsEntries.sort((a, b) => {
	const aIndex = order.indexOf(a.slug);
	const bIndex = order.indexOf(b.slug);
	if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
	if (aIndex !== -1) return -1;
	if (bIndex !== -1) return 1;
	return a.data.title.localeCompare(b.data.title);
});
---

<Layout title="gaur docs - get started">
	<div class="flex max-w-7xl mx-auto min-h-[calc(100vh-4rem)]">
		<!-- Sidebar -->
		<DocsSidebar currentSlug="index" />

		<!-- Main Content Section -->
		<article class="flex-grow p-8 md:p-12 lg:p-16 overflow-hidden">
			<div class="max-w-4xl mx-auto">
				<header class="mb-16">
					<h1 class="text-4xl md:text-6xl font-extrabold text-primary mb-6 tracking-tight">docs</h1>
					<p class="text-xl text-muted/80 leading-relaxed max-w-2xl">
						everything you need to install, configure, and use gaur.
					</p>
				</header>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{docsEntries.map(entry => (
						<a
							href={`/docs/${entry.slug}`}
							class="group p-8 rounded-gaur border border-muted/20 bg-surface hover:border-primary/50 hover:shadow-glow transition-all duration-300"
						>
							<h2 class="text-2xl font-bold text-highlight group-hover:text-primary mb-3 transition-colors tracking-tight">
								{entry.data.title}
							</h2>
							<p class="text-text/70 text-base leading-relaxed">
								{entry.data.description}
							</p>
						</a>
					))}
				</div>

			<div class="mt-20 p-8 rounded-gaur border border-highlight/20 bg-highlight/5">
				<h3 class="text-xl font-bold text-highlight mb-4">quick start</h3>
				<p class="text-text/80 mb-6">grab gaur from the aur and you're ready to go. one command, zero fuss.</p>
				<div class="flex flex-wrap gap-4 mb-2">
					<button class="docs-qs-tab active text-[10px] font-bold text-mauve tracking-widest uppercase transition-all hover:text-mauve" data-cmd="paru -S gaur-bin">
						[ paru ]
					</button>
					<button class="docs-qs-tab text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="yay -S gaur-bin">
						[ yay ]
					</button>
					<button class="docs-qs-tab text-[10px] font-bold text-subtext0 tracking-widest uppercase transition-all hover:text-mauve" data-cmd="go install github.com/prbhtkumr/gaur@latest">
						[ go ]
					</button>
				</div>
				<div class="bg-crust border border-surface0 rounded-gaur p-3 md:p-4 flex flex-col md:flex-row items-center justify-between group shadow-xl gap-4">
					<div class="flex items-center gap-3 w-full md:w-auto">
						<span class="text-green font-bold">$</span>
						<code id="docs-qs-cmd" class="text-green/90 text-[11px] break-all">paru -S gaur-bin</code>
					</div>
					<button id="docs-qs-copy" class="w-full md:w-auto px-6 py-2 md:py-1 text-[10px] font-bold border border-mauve text-mauve hover:bg-mauve/10 transition-all rounded-gaur uppercase tracking-widest">
						COPY
					</button>
				</div>
			</div>
			</div>
		</article>
	</div>
</Layout>

<script>
	document.querySelectorAll('.docs-qs-tab').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const t = e.currentTarget as HTMLButtonElement;
			document.querySelectorAll('.docs-qs-tab').forEach(b => {
				b.classList.remove('active', 'text-mauve');
				b.classList.add('text-subtext0');
			});
			t.classList.add('active', 'text-mauve');
			t.classList.remove('text-subtext0');
			const cmdEl = document.getElementById('docs-qs-cmd');
			if (cmdEl && t.dataset.cmd) cmdEl.textContent = t.dataset.cmd;
		});
	});

	const copyBtn = document.getElementById('docs-qs-copy');
	copyBtn?.addEventListener('click', () => {
		const cmd = document.getElementById('docs-qs-cmd')?.textContent;
		if (cmd) {
			navigator.clipboard.writeText(cmd);
			const ot = copyBtn.textContent;
			copyBtn.textContent = 'DONE';
			copyBtn.classList.replace('text-mauve', 'text-green');
			copyBtn.classList.replace('border-mauve', 'border-green');
			setTimeout(() => {
				copyBtn.textContent = ot;
				copyBtn.classList.replace('text-green', 'text-mauve');
				copyBtn.classList.replace('border-green', 'border-mauve');
			}, 2000);
		}
	});
</script>
