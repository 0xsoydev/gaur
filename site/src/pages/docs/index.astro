---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import DocsSidebar from '../../components/DocsSidebar.astro';

const docsEntries = await getCollection('docs');

// Sort them so Installation is first, then Usage, etc.
const order = ['installation', 'usage', 'configuration', 'internals'];
docsEntries.sort((a, b) => {
	const aIndex = order.indexOf(a.slug);
	const bIndex = order.indexOf(b.slug);
	if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
	if (aIndex !== -1) return -1;
	if (bIndex !== -1) return 1;
	return a.data.title.localeCompare(b.data.title);
});
---

<Layout title="gaur documentation - overview">
	<div class="flex max-w-7xl mx-auto min-h-[calc(100vh-4rem)]">
		<!-- Sidebar -->
		<DocsSidebar currentSlug="index" />

		<!-- Main Content Section -->
		<article class="flex-grow p-8 md:p-12 lg:p-16 overflow-hidden">
			<div class="max-w-4xl mx-auto">
				<header class="mb-16">
					<h1 class="text-4xl md:text-6xl font-extrabold text-primary mb-6 tracking-tight">documentation</h1>
					<p class="text-xl text-muted/80 leading-relaxed max-w-2xl">
						welcome to the gaur documentation. here you'll find everything you need to know about installing, configuring, and mastering gaur for your arch linux setup.
					</p>
				</header>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					{docsEntries.map(entry => (
						<a 
							href={`/docs/${entry.slug}`} 
							class="group p-8 rounded-gaur border border-muted/20 bg-surface hover:border-primary/50 hover:shadow-glow transition-all duration-300"
						>
							<h2 class="text-2xl font-bold text-highlight group-hover:text-primary mb-3 transition-colors tracking-tight">
								{entry.data.title}
							</h2>
							<p class="text-text/70 text-base leading-relaxed">
								{entry.data.description}
							</p>
						</a>
					))}
				</div>

				<div class="mt-20 p-8 rounded-gaur border border-highlight/20 bg-highlight/5">
					<h3 class="text-xl font-bold text-highlight mb-4">quick start</h3>
					<p class="text-text/80 mb-6">ready to jump right in? install gaur using your favorite aur helper and start managing your packages beautifully.</p>
					<code class="block bg-mantle p-4 rounded-sm border border-muted/10 text-pink font-bold">
						paru -S gaur-bin
					</code>
				</div>
			</div>
		</article>
	</div>
</Layout>
