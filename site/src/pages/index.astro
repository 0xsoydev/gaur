---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
---

<Layout title="Gaur - Arch Linux Package Manager TUI">
	<!-- Hero Section -->
	<section class="pt-20 pb-12 text-center overflow-hidden">
		<div class="px-4">
			<h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4">
				<span class="text-primary">Gaur</span>
			</h1>
			<p class="text-lg md:text-xl text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
				A beautiful, interactive terminal user interface (TUI) designed to make Arch Linux package management both powerful and visually striking.
			</p>
			
			<div class="flex items-center justify-center gap-4 mb-16">
				<a href="/gaur/docs" class="px-6 py-2 bg-primary text-background font-bold rounded-sm hover:opacity-90 transition-opacity">
					Get Started
				</a>
				<a href="https://github.com/prbhtkumr/gaur" class="px-6 py-2 border border-muted/30 text-text font-bold rounded-sm hover:bg-surface transition-colors">
					View on GitHub
				</a>
			</div>
		</div>

		<TerminalHero />
	</section>

	<!-- About / Philosophy Section (from Introduction) -->
	<section class="max-w-4xl mx-auto px-4 py-20 border-t border-muted/10">
		<div class="space-y-12">
			<div>
				<h2 class="text-3xl font-bold text-primary mb-6 tracking-tight">Core Philosophy</h2>
				<p class="text-lg text-text/80 leading-relaxed">
					Gaur is designed for users who demand speed and total control without sacrificing aesthetics. It doesn't just run commands; it creates an immersive environment for managing your system's package ecosystem, providing detailed insights right from the terminal.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
				<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm">
					<h3 class="text-xl font-bold text-highlight mb-4">Fuzzy Search</h3>
					<p class="text-sm text-muted leading-relaxed">Powered by <code class="text-pink">fzf</code> for lightning-fast matching across official repos and the AUR.</p>
				</div>
				<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm">
					<h3 class="text-xl font-bold text-highlight mb-4">System Dashboard</h3>
					<p class="text-sm text-muted leading-relaxed">Real-time stats on disk usage, repository distribution, and cache management.</p>
				</div>
				<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm">
					<h3 class="text-xl font-bold text-highlight mb-4">Selective Updates</h3>
					<p class="text-sm text-muted leading-relaxed">Carefully manage your system by selecting specific packages to update.</p>
				</div>
				<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm">
					<h3 class="text-xl font-bold text-highlight mb-4">Batch Operations</h3>
					<p class="text-sm text-muted leading-relaxed">Mark multiple packages with <code class="text-pink">Tab</code> and process them all at once.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Minimal ASCII decoration -->
	<div class="py-20 text-center opacity-10">
		<pre class="inline-block text-[10px] md:text-xs">
      :::::::::::      :::     :::    ::: :::::::::  
     :+:      :+:    :+: :+:   :+:    :+: :+:    :+: 
    +:+     +:+    +:+   +:+  +:+    +:+ +:+    +:+  
   +#+    +#+    +#++:++#++: +#+    +:+ +#++:++#:    
  +#+   +#+     +#+     +#+ +#+    +#+ +#+    +#+    
 #+#  #+#      #+#     #+# #+#    #+# #+#    #+#     
#########     ###     ###  ########  ###    ###      
		</pre>
	</div>
</Layout>
