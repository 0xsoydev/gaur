---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
---

<Layout title="Gaur - Arch Linux Package Manager TUI">
	<!-- Hero Section -->
	<section class="pt-20 pb-12 text-center overflow-hidden">
		<div class="px-4">
			<h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4">
				<span class="text-primary">Gaur</span>
			</h1>
			<p class="text-lg md:text-xl text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
				A beautiful, interactive TUI for Arch Linux package management. Built for speed, precision, and aesthetics.
			</p>
			
			<div class="flex items-center justify-center gap-4 mb-16">
				<a href="/docs" class="px-6 py-2 bg-primary text-background font-bold rounded-sm hover:opacity-90 transition-opacity">
					Get Started
				</a>
				<a href="https://github.com/prbhtkumr/gaur" class="px-6 py-2 border border-muted/30 text-text font-bold rounded-sm hover:bg-surface transition-colors">
					View on GitHub
				</a>
			</div>
		</div>

		<TerminalHero />
	</section>

	<!-- Features Grid -->
	<section class="max-w-6xl mx-auto px-4 py-20 border-t border-muted/10">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
			<div class="space-y-4">
				<div class="text-blue text-2xl font-bold">01.</div>
				<h3 class="text-xl font-bold text-highlight tracking-tight">&gt; search/fuzzy</h3>
				<p class="text-muted text-sm leading-relaxed">
					Lightning-fast fuzzy matching powered by <code class="text-pink">fzf</code>. Instantly find any package across official repos and the AUR.
				</p>
			</div>
			
			<div class="space-y-4">
				<div class="text-blue text-2xl font-bold">02.</div>
				<h3 class="text-xl font-bold text-primary tracking-tight">&gt; system/dashboard</h3>
				<p class="text-muted text-sm leading-relaxed">
					Comprehensive system overview. Track disk usage, identify large packages, and manage your pacman cache in one view.
				</p>
			</div>

			<div class="space-y-4">
				<div class="text-blue text-2xl font-bold">03.</div>
				<h3 class="text-xl font-bold text-accent tracking-tight">&gt; theme/custom</h3>
				<p class="text-muted text-sm leading-relaxed">
					Deep customization support. Built-in themes for Catppuccin, Gruvbox, Tokyo Night, and more. Make it yours.
				</p>
			</div>
		</div>
	</section>

	<!-- Minimal ASCII decoration -->
	<div class="py-20 text-center opacity-10">
		<pre class="inline-block text-[10px] md:text-xs">
      :::::::::::      :::     :::    ::: :::::::::  
     :+:      :+:    :+: :+:   :+:    :+: :+:    :+: 
    +:+     +:+    +:+   +:+  +:+    +:+ +:+    +:+  
   +#+    +#+    +#++:++#++: +#+    +:+ +#++:++#:    
  +#+   +#+     +#+     +#+ +#+    +#+ +#+    +#+    
 #+#  #+#      #+#     #+# #+#    #+# #+#    #+#     
#########     ###     ###  ########  ###    ###      
		</pre>
	</div>
</Layout>
