---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
---

<Layout title="gaur - arch linux package manager tui">
	<!-- Scroll Indicator (Vertical Bar) -->
	<div class="fixed right-6 top-1/2 -translate-y-1/2 z-50 hidden lg:flex">
		<div class="w-1 h-48 bg-surface1/30 rounded-full relative overflow-hidden">
			<div id="scroll-progress" class="absolute top-0 left-0 w-full bg-primary/60 transition-all duration-150 rounded-full" style="height: 0%"></div>
		</div>
	</div>

	<div class="snap-container h-[calc(100vh-4rem)] overflow-y-auto snap-y snap-mandatory scroll-smooth" id="main-snap-container">
		<!-- Hero Section -->
		<section class="min-h-full flex flex-col pt-32 pb-12 text-center overflow-hidden snap-start relative">
			<div class="px-4">
				<h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4 flex items-center justify-center gap-4">
					<span class="text-green drop-shadow-[0_0_8px_rgba(166,227,161,0.5)]">></span>
					<span class="text-primary drop-shadow-[0_0_15px_rgba(203,166,247,0.4)]">[gaur]</span>
					<span class="w-4 h-12 md:w-6 md:h-20 bg-primary/80 animate-pulse"></span>
				</h1>
				<p class="text-lg md:text-xl text-muted max-w-2xl mx-auto mb-10 leading-relaxed">
					a beautiful, interactive terminal user interface (tui) designed to make arch linux package management both powerful and visually striking.
				</p>
				
				<div class="flex items-center justify-center gap-4 mb-8">
					<a href="/gaur/docs" class="px-6 py-2 bg-primary text-background font-bold rounded-sm hover:opacity-90 transition-opacity">
						get started
					</a>
					<a href="https://github.com/prbhtkumr/gaur" class="px-6 py-2 border border-muted/30 text-text font-bold rounded-sm hover:bg-surface transition-colors">
						view on github
					</a>
				</div>
			</div>

			<TerminalHero />

			<!-- Threshold Indicator (Bottom Glow) -->
			<div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-500 threshold-indicator"></div>
		</section>

		<!-- About / Philosophy Section -->
		<section class="min-h-full flex flex-col pt-32 pb-12 px-4 border-t border-muted/10 snap-start relative">
			<div class="max-w-4xl mx-auto w-full space-y-12">
				<div>
					<h2 class="text-3xl font-bold text-primary mb-6 tracking-tight">core philosophy</h2>
					<p class="text-lg text-text/80 leading-relaxed">
						gaur is designed for users who demand speed and total control without sacrificing aesthetics. it doesn't just run commands; it creates an immersive environment for managing your system's package ecosystem, providing detailed insights right from the terminal.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
					<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-4">fuzzy search</h3>
						<p class="text-sm text-muted leading-relaxed">powered by <code class="text-pink">fzf</code> for lightning-fast matching across official repos and the aur.</p>
					</div>
					<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-4">system dashboard</h3>
						<p class="text-sm text-muted leading-relaxed">real-time stats on disk usage, repository distribution, and cache management.</p>
					</div>
					<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-4">selective updates</h3>
						<p class="text-sm text-muted leading-relaxed">carefully manage your system by selecting specific packages to update.</p>
					</div>
					<div class="p-6 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-4">batch operations</h3>
						<p class="text-sm text-muted leading-relaxed">mark multiple packages with <code class="text-pink">tab</code> and process them all at once.</p>
					</div>
				</div>
			</div>
			<!-- Threshold Indicator -->
			<div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-500 threshold-indicator"></div>
		</section>

		<!-- Minimal ASCII decoration / Footer section -->
		<section class="min-h-full flex flex-col pt-32 pb-12 text-center opacity-30 snap-start border-t border-muted/10">
			<pre class="inline-block text-[10px] md:text-xs">
      :::::::::::      :::     :::    ::: :::::::::  
     :+:      :+:    :+: :+:   :+:    :+: :+:    :+: 
    +:+     +:+    +:+   +:+  +:+    +:+ +:+    +:+  
   +#+    +#+    +#++:++#++: +#+    +:+ +#++:++#:    
  +#+   +#+     +#+     +#+ +#+    +#+ +#+    +#+    
 #+#  #+#      #+#     #+# #+#    #+# #+#    #+#     
#########     ###     ###  ########  ###    ###      
			</pre>
			<p class="mt-12 text-xs font-mono tracking-widest uppercase opacity-40">end of system report</p>
		</section>
	</div>
</Layout>

<script>
	const container = document.getElementById('main-snap-container');
	const progress = document.getElementById('scroll-progress');
	const indicators = document.querySelectorAll('.threshold-indicator');
	const sections = container?.querySelectorAll('section');

	if (container && progress && sections) {
		container.addEventListener('scroll', () => {
			const scrollPercent = (container.scrollTop / (container.scrollHeight - container.clientHeight)) * 100;
			progress.style.height = `${scrollPercent}%`;

			// Visual feedback for threshold: as you approach the end of a section, show a glow
			sections.forEach((section, i) => {
				const sectionTop = section.offsetTop;
				const sectionHeight = section.clientHeight;
				const relativeScroll = container.scrollTop - sectionTop;
				
				// Threshold glow: starts appearing after 70% of the section is scrolled
				const threshold = sectionHeight * 0.7;
				const indicator = section.querySelector('.threshold-indicator');
				
				if (indicator && i < sections.length - 1) {
					if (relativeScroll > threshold) {
						const opacity = (relativeScroll - threshold) / (sectionHeight - threshold);
						(indicator as HTMLElement).style.opacity = String(opacity * 0.5);
					} else {
						(indicator as HTMLElement).style.opacity = '0';
					}
				}
			});
		});
	}
</script>
