---
import Layout from '../layouts/Layout.astro';
import TerminalHero from '../components/TerminalHero.astro';
---

<Layout title="gaur - terminal-native arch linux package manager" hideFooter={true}>
	<!-- Scroll Indicator (Vertical Bar) -->
	<div class="fixed right-6 top-1/2 -translate-y-1/2 z-50 hidden lg:flex">
		<div class="w-1 h-48 bg-surface1/30 rounded-full relative overflow-hidden">
			<div id="scroll-progress" class="absolute top-0 left-0 w-full bg-primary/60 transition-all duration-150 rounded-full" style="height: 0%"></div>
		</div>
	</div>

	<div class="snap-container h-[calc(100vh-4rem)] overflow-y-auto snap-y snap-mandatory scroll-smooth" id="main-snap-container">
		<!-- Hero Section -->
		<section class="min-h-full flex flex-col pt-12 pb-8 text-center overflow-hidden snap-start relative">
			<div class="flex-grow flex flex-col justify-center px-4">
				<h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4 flex items-center justify-center gap-4">
					<span class="text-green drop-shadow-[0_0_8px_rgba(166,227,161,0.5)]">></span>
					<span class="text-primary drop-shadow-[0_0_15px_rgba(203,166,247,0.4)]">[gaur]</span>
					<span class="w-4 h-12 md:w-6 md:h-20 bg-primary/80 animate-pulse"></span>
				</h1>
			<p class="text-lg md:text-xl text-muted max-w-2xl mx-auto mb-4 leading-relaxed">
				your arch packages deserve better than raw pacman output. search, install, update, and clean up, all from one keyboard-driven interface.
			</p>
			</div>

			<div class="flex-shrink-0">
				<TerminalHero />
			</div>

			<!-- Threshold Indicator (Bottom Glow) -->
			<div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-500 threshold-indicator"></div>
		</section>

		<!-- About / Philosophy Section -->
		<section class="min-h-full flex flex-col px-4 border-t border-muted/10 snap-start relative">
			<div class="max-w-4xl mx-auto w-full flex-grow flex flex-col justify-center py-8">
				<div class="space-y-8">
				<div>
					<h2 class="text-3xl font-bold text-primary mb-4 tracking-tight">why gaur?</h2>
					<p class="text-lg text-text/80 leading-relaxed">
						managing packages on arch shouldn't feel like archaeology. gaur brings clarity to your system with real-time stats, fuzzy search, and batch operations. power users stay in flow; newcomers stop guessing.
					</p>
				</div>

					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div class="p-5 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-3">instant search</h3>
						<p class="text-sm text-muted leading-relaxed"><code class="text-pink">fzf</code>-powered fuzzy matching across repos and the aur. find any package in milliseconds.</p>
					</div>
					<div class="p-5 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-3">live dashboard</h3>
						<p class="text-sm text-muted leading-relaxed">see disk usage, orphans, cache bloat, and repo breakdowns at a glance. no more guesswork.</p>
					</div>
					<div class="p-5 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-3">granular updates</h3>
						<p class="text-sm text-muted leading-relaxed">full system upgrade or cherry-pick specific packages. you decide what gets updated.</p>
					</div>
					<div class="p-5 rounded-gaur border border-muted/20 bg-surface/50 shadow-sm hover:border-primary/30 transition-colors">
						<h3 class="text-xl font-bold text-highlight mb-3">batch actions</h3>
						<p class="text-sm text-muted leading-relaxed">mark multiple packages with <code class="text-pink">tab</code>, then install or remove them in one shot.</p>
					</div>
					</div>
				</div>
			</div>

			<!-- Sticky Footer Area -->
			<div class="w-full pb-8 text-center flex-shrink-0">
				<div class="opacity-20 mb-6 flex justify-center">
					<pre class="text-[10px] md:text-xs leading-none text-left">
	  ::::::::      :::     :::    ::: :::::::::
    :+:    :+:   :+: :+:   :+:    :+: :+:    :+:
   +:+         +:+   +:+  +:+    +:+ +:+    +:+
  :#:        +#++:++#++: +#+    +:+ +#++:++#:
 +#+   +#+# +#+     +#+ +#+    +#+ +#+    +#+
#+#    #+# #+#     #+# #+#    #+# #+#    #+#
########  ###     ###  ########  ###    ###
					</pre>
				</div>

				<div class="text-muted/40 text-[10px] font-mono tracking-tight">
					<p>© {new Date().getFullYear()} gaur. open source under gplv3.</p>
					<p class="mt-1">crafted with astro + tailwind. made for arch users, by arch users.</p>
				</div>
			</div>

			<!-- Threshold Indicator -->
			<div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent opacity-0 transition-opacity duration-500 threshold-indicator"></div>
		</section>
	</div>
</Layout>

<script>
	const container = document.getElementById('main-snap-container');
	const progress = document.getElementById('scroll-progress');
	const indicators = document.querySelectorAll('.threshold-indicator');
	const sections = container?.querySelectorAll('section');

	if (container && progress && sections) {
		container.addEventListener('scroll', () => {
			const scrollPercent = (container.scrollTop / (container.scrollHeight - container.clientHeight)) * 100;
			progress.style.height = `${scrollPercent}%`;

			// Visual feedback for threshold: as you approach the end of a section, show a glow
			sections.forEach((section, i) => {
				const sectionTop = section.offsetTop;
				const sectionHeight = section.clientHeight;
				const relativeScroll = container.scrollTop - sectionTop;

				// Threshold glow: starts appearing after 70% of the section is scrolled
				const threshold = sectionHeight * 0.7;
				const indicator = section.querySelector('.threshold-indicator');

				if (indicator && i < sections.length - 1) {
					if (relativeScroll > threshold) {
						const opacity = (relativeScroll - threshold) / (sectionHeight - threshold);
						(indicator as HTMLElement).style.opacity = String(opacity * 0.5);
					} else {
						(indicator as HTMLElement).style.opacity = '0';
					}
				}
			});
		});
	}
</script>
